#include "windef.h"
#include "winuser.h"
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_EXPLORER_TITLE  "Wine Explorer"
    IDS_PATHBOX_LABEL   "Location:"
    IDS_START_LABEL     "Start"
    IDS_RUN             "&Run..."
    IDS_EXIT_LABEL      "E&xit desktop"
    IDS_EXIT_PROMPT     "Are you sure you want to close all programs and exit the virtual desktop?"
    IDS_DESKTOP_TITLE   "Wine Desktop"
    IDS_TASKBAR_LOCK    "&Lock the Taskbar"
    IDS_TASKBAR_SIZE    "Taskbar &Size"
    IDS_TASKBAR_ROWS1   "&Single Row"
    IDS_TASKBAR_ROWS2   "&Double Row"
    IDS_TASKBAR_ROWS3   "&Triple Row"
    IDS_TASK_MANAGER    "Tas&k Manager"
    IDS_XP_ALL_PROGRAMS "All &Programs"
    IDS_XP_FILE_MANAGER "File Manager"
    IDS_XP_COMMAND_PROMPT "Command Prompt"
    IDS_XP_MY_DOCUMENTS "My Documents"
    IDS_XP_MY_PICTURES  "My Pictures"
    IDS_XP_MY_MUSIC     "My Music"
    IDS_XP_MY_COMPUTER  "My Computer"
    IDS_XP_CONTROL_PANEL "Control Panel"
    IDS_XP_WINECFG      "Wine Configuration"
    IDS_XP_TURN_OFF     "T&urn Off Computer"
    IDS_DP_STYLE_XP     "Windows XP style"
    IDS_DP_STYLE_CLASSIC "Windows Classic style"
    IDS_DP_SCHEME_BLUE  "Default (blue)"
    IDS_DP_SCHEME_OLIVE "Olive Green"
    IDS_DP_SCHEME_SILVER "Silver"
    IDS_DESKTOP_REFRESH "R&efresh"
    IDS_DESKTOP_PROPERTIES "Display P&roperties"
}

IDD_DISPLAY_PROPERTIES DIALOGEX 0, 0, 262, 238
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Properties"
FONT 8, "MS Shell Dlg"
{
    CONTROL         "", IDC_DP_PREVIEW, "Static", SS_OWNERDRAW, 7, 7, 248, 62
    GROUPBOX        "Theme", -1, 7, 75, 248, 56
    LTEXT           "&Windows and buttons:", -1, 14, 90, 90, 10
    COMBOBOX        IDC_DP_STYLE, 108, 88, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Color scheme:", -1, 14, 110, 90, 10
    COMBOBOX        IDC_DP_SCHEME, 108, 108, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Taskbar", -1, 7, 137, 248, 72
    LTEXT           "Taskbar &size:", -1, 14, 152, 90, 10
    COMBOBOX        IDC_DP_ROWS, 108, 150, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Lock the taskbar", IDC_DP_LOCK, 14, 173, 140, 10
    AUTOCHECKBOX    "Show the cloc&k", IDC_DP_CLOCK, 14, 190, 140, 10
    DEFPUSHBUTTON   "OK", IDOK, 91, 217, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 147, 217, 50, 14
    PUSHBUTTON      "&Apply", IDC_DP_APPLY, 203, 217, 50, 14
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

#define WINE_FILEDESCRIPTION_STR "Wine Explorer"
#define WINE_FILENAME_STR "explorer.exe"
#define WINE_FILEVERSION 6,1,7601,17567
#define WINE_FILEVERSION_STR "6.1.7601.17567"
#define WINE_PRODUCTVERSION 6,1,7601,17567
#define WINE_PRODUCTVERSION_STR "6.1.7601.17567"

#include "wine/wine_common_ver.rc"

/* @makedep: explorer.manifest */
1 RT_MANIFEST explorer.manifest

/* @makedep: wine.ico */
IDI_WINE_LOGO ICON wine.ico
