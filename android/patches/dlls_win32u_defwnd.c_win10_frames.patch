+/*
+ * Windows 10 style frames (HKCU\Software\Wine\Explorer\Taskbar: Style "win10"): a flat title bar,
+ * dark grey ("Dark", on by default) or white, a one pixel border in the accent color ("Accent",
+ * dark grey by default) and flat caption buttons. Same sizes as the other frames.
+ */
+#define WIN10_DEFAULT_ACCENT RGB(0x33,0x33,0x33)
+static const struct xp_stop win10_light_caption[] = { { 0, RGB(0xff,0xff,0xff) }, { 100, RGB(0xff,0xff,0xff) } };
+static const struct xp_stop win10_dark_caption[] = { { 0, RGB(0x20,0x20,0x20) }, { 100, RGB(0x20,0x20,0x20) } };
+static const struct xp_stop win10_dark_caption_inactive[] = { { 0, RGB(0x2b,0x2b,0x2b) }, { 100, RGB(0x2b,0x2b,0x2b) } };
+
+#define WIN10_FRAME( caption, back, border, text ) \
+    { caption, ARRAY_SIZE(caption), { border, back, back }, { border, back, back }, back, \
+      text, CLR_INVALID, back, back, back, text }
+#define WIN10_LIGHT( accent ) \
+    { WIN10_FRAME( win10_light_caption, RGB(0xff,0xff,0xff), accent, RGB(0x00,0x00,0x00) ), \
+      WIN10_FRAME( win10_light_caption, RGB(0xff,0xff,0xff), RGB(0xaa,0xaa,0xaa), RGB(0x99,0x99,0x99) ) }
+#define WIN10_DARK( accent ) \
+    { WIN10_FRAME( win10_dark_caption, RGB(0x20,0x20,0x20), accent, RGB(0xff,0xff,0xff) ), \
+      WIN10_FRAME( win10_dark_caption_inactive, RGB(0x2b,0x2b,0x2b), RGB(0x44,0x44,0x44), RGB(0x88,0x88,0x88) ) }
+
+/* light and dark, active and inactive; the active border takes the accent color when it is read */
+static struct xp_frame_colors win10_frames[2][2] =
+{
+    WIN10_LIGHT( WIN10_DEFAULT_ACCENT ), WIN10_DARK( WIN10_DEFAULT_ACCENT ),
+};
+
+static BOOL is_win10_frame( const struct xp_frame_colors *colors )
+{
+    return colors >= &win10_frames[0][0] && colors < &win10_frames[0][0] + 4;
+}
