+/* a flat Windows 10 style caption button over the full height of the title bar, with a thin glyph;
+ * pressed, the close button turns red */
+static void win10_draw_caption_button( HWND hwnd, HDC hdc, const RECT *rect, UINT flags,
+                                       const struct xp_frame_colors *colors )
+{
+    BOOL down = (flags & DFCS_PUSHED) != 0, grayed = (flags & DFCS_INACTIVE) != 0;
+    BOOL dark = GetRValue( colors->fill ) < 0x80;
+    UINT type = flags & 0xff;
+    DWORD style = get_window_long( hwnd, GWL_STYLE ), ex_style = get_window_long( hwnd, GWL_EXSTYLE );
+    int width, height, size, x, y, t = max( 1, muldiv( 1, get_dpi_for_window( hwnd ), 96 ));
+    COLORREF back = colors->fill, glyph = colors->glyph;
+    HBITMAP bitmap, prev_bitmap;
+    RECT caption, box;
+    HDC mem;
+
+    get_inside_rect( hwnd, COORDS_WINDOW, &caption, style, ex_style );
+    caption.bottom = caption.top + get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CYSMCAPTION : SM_CYCAPTION );
+    /* the classic button rectangles leave a two pixel gap on their right, the flat buttons fill it */
+    box.left = rect->left;
+    box.right = min( rect->right + 2, caption.right );
+    box.top = caption.top;
+    box.bottom = caption.bottom;
+    width = box.right - box.left;
+    height = box.bottom - box.top;
+    if (width <= 4 || height <= 4) return;
+
+    if (down)
+    {
+        if (type == DFCS_CAPTIONCLOSE)
+        {
+            back = RGB(0xe8,0x11,0x23);
+            glyph = RGB(0xff,0xff,0xff);
+        }
+        else back = dark ? RGB(0x44,0x44,0x44) : RGB(0xcc,0xcc,0xcc);
+    }
+    if (grayed) glyph = RGB( (GetRValue( glyph ) + 2 * GetRValue( back )) / 3, (GetGValue( glyph ) + 2 * GetGValue( back )) / 3,
+                             (GetBValue( glyph ) + 2 * GetBValue( back )) / 3 );
+
+    if (!(mem = NtGdiCreateCompatibleDC( hdc ))) return;
+    if (!(bitmap = NtGdiCreateCompatibleBitmap( hdc, width, height )))
+    {
+        NtGdiDeleteObjectApp( mem );
+        return;
+    }
+    prev_bitmap = NtGdiSelectBitmap( mem, bitmap );
+    xp_fill( mem, 0, 0, width, height, back );
+
+    size = max( 8, min( width, height ) * 2 / 5 );
+    size -= size % 2;
+    x = (width - size) / 2;
+    y = (height - size) / 2;
+    switch (type)
+    {
+    case DFCS_CAPTIONCLOSE:
+        xp_draw_line( mem, x, y, x + size, y + size, t, glyph );
+        xp_draw_line( mem, x + size, y, x, y + size, t, glyph );
+        break;
+    case DFCS_CAPTIONMIN:
+        xp_fill( mem, x, y + size / 2, size, t, glyph );
+        break;
+    case DFCS_CAPTIONMAX:
+        xp_fill( mem, x, y, size, t, glyph );
+        xp_fill( mem, x, y + size - t, size, t, glyph );
+        xp_fill( mem, x, y, t, size, glyph );
+        xp_fill( mem, x + size - t, y, t, size, glyph );
+        break;
+    case DFCS_CAPTIONRESTORE:
+    {
+        int s = size * 4 / 5, d = size - s;
+
+        /* the back window, then the front one */
+        xp_fill( mem, x + d, y, s, t, glyph );
+        xp_fill( mem, x + size - t, y, t, s, glyph );
+        xp_fill( mem, x, y + d, s, t, glyph );
+        xp_fill( mem, x, y + size - t, s, t, glyph );
+        xp_fill( mem, x, y + d, t, s, glyph );
+        xp_fill( mem, x + s - t, y + d, t, s, glyph );
+        xp_fill( mem, x + d, y, t, d, glyph );
+        xp_fill( mem, x + s, y + s - t, d, t, glyph );
+        break;
+    }
+    }
+
+    NtGdiBitBlt( hdc, box.left, box.top, width, height, mem, 0, 0, SRCCOPY, 0, 0 );
+    NtGdiSelectBitmap( mem, prev_bitmap );
+    NtGdiDeleteObjectApp( bitmap );
+    NtGdiDeleteObjectApp( mem );
+}
