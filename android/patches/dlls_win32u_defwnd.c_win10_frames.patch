+/* light the button under the pointer and put out the one before; a system timer checks the
+ * pointer while one is lit, so that leaving the button, or the window, puts it out too */
+static void set_caption_hot( HWND hwnd, UINT ht )
+{
+    HWND old_hwnd = win10_hot_hwnd;
+    UINT old_ht = win10_hot_ht;
+
+    if (!ht) hwnd = 0;
+    if (hwnd == old_hwnd && ht == old_ht) return;
+    win10_hot_hwnd = hwnd;
+    win10_hot_ht = ht;
+    if (old_hwnd && is_window( old_hwnd )) redraw_caption_button( old_hwnd, old_ht );
+    if (hwnd)
+    {
+        redraw_caption_button( hwnd, ht );
+        NtUserSetSystemTimer( hwnd, SYSTEM_TIMER_CAPTION_HOT, 100 );
+    }
+}
+
+static void track_caption_hot( HWND hwnd, WPARAM ht )
+{
+    DWORD style = get_window_long( hwnd, GWL_STYLE ), ex_style = get_window_long( hwnd, GWL_EXSTYLE );
+    const struct xp_frame_colors *colors;
+
+    if (ht != HTCLOSE && ht != HTMAXBUTTON && ht != HTMINBUTTON) ht = 0;
+    else if (!(colors = get_xp_window_colors( hwnd, style, ex_style )) || !is_win10_frame( colors )) ht = 0;
+    if (ht || hwnd == win10_hot_hwnd) set_caption_hot( hwnd, ht );
+}
+
+/* SYSTEM_TIMER_CAPTION_HOT */
+void check_caption_hot( HWND hwnd )
+{
+    POINT pt;
+
+    if (hwnd != win10_hot_hwnd)
+    {
+        NtUserKillSystemTimer( hwnd, SYSTEM_TIMER_CAPTION_HOT );
+        return;
+    }
+    if (!NtUserGetCursorPos( &pt ) || NtUserWindowFromPoint( pt.x, pt.y ) != hwnd ||
+        handle_nc_hit_test( hwnd, pt ) != win10_hot_ht)
+    {
+        set_caption_hot( 0, 0 );
+        NtUserKillSystemTimer( hwnd, SYSTEM_TIMER_CAPTION_HOT );
+    }
+}
