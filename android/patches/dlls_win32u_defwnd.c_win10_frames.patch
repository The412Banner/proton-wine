+/* draw one caption button again, for its hover state */
+static void redraw_caption_button( HWND hwnd, UINT ht )
+{
+    DWORD style = get_window_long( hwnd, GWL_STYLE );
+    HMENU sys_menu;
+    UINT state;
+    HDC hdc;
+
+    if (!(style & WS_SYSMENU) || !(hdc = NtUserGetWindowDC( hwnd ))) return;
+    switch (ht)
+    {
+    case HTCLOSE:
+        sys_menu = NtUserGetSystemMenu( hwnd, FALSE );
+        state = sys_menu ? get_menu_state( sys_menu, SC_CLOSE, MF_BYCOMMAND ) : 0xffffffff;
+        draw_close_button( hwnd, hdc, FALSE, (state & (MF_DISABLED | MF_GRAYED)) || state == 0xffffffff );
+        break;
+    case HTMAXBUTTON:
+        if (style & (WS_MAXIMIZEBOX | WS_MINIMIZEBOX)) draw_max_button( hwnd, hdc, FALSE, !(style & WS_MAXIMIZEBOX) );
+        break;
+    case HTMINBUTTON:
+        if (style & (WS_MAXIMIZEBOX | WS_MINIMIZEBOX)) draw_min_button( hwnd, hdc, FALSE, !(style & WS_MINIMIZEBOX) );
+        break;
+    }
+    NtUserReleaseDC( hwnd, hdc );
+}
