ntdll: take work off the Sleep(0) throttle run when the thread worked between two yields.

The GameNative #119 throttle (dlls_ntdll_unix_sync.c_sleep0_yield_throttle.patch) starts a new run only
after a gap of more than 2 ms or a wait with a non-zero timeout. A loop that yields a few times per frame
while waiting on another thread and runs faster than 2 ms per frame never starts a new run, so after 50000
yields every frame gets the 250 us sleep: AIO DirectDraw on the Pocket FIT went from ~2785 to ~1460 fps
(WINE_SLEEP0_THROTTLE=0: 2775/2789).

When the thread used more than 20 us of its own CPU time (CLOCK_THREAD_CPUTIME_ID) since the previous
non-switching yield, 1000 yields are taken off its run. A frame loop does that every frame and never
reaches the threshold; an idle spinner (~1 us per yield) only sees an occasional long gap (interrupts),
so it is still throttled. Measured on the Pocket FIT: resetting the run to 0 instead let idle spinners
run at 43-77 % CPU (GN default 2 %). Time spent preempted is not counted.
WINE_SLEEP0_THROTTLE=<iters>,<usec>,<work_us>,<credit> (work_us 0 = old behaviour).

--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2581,31 +2581,58 @@
  *
  * WINE_SLEEP0_THROTTLE=0 disables it, WINE_SLEEP0_THROTTLE=<iters>[,<usec>] sets
  * the threshold and the sleep length.
+ *
+ * Work credit: a thread that used more than SLEEP0_DEFAULT_WORK_USEC of its own CPU
+ * time between two yields did real work in between (a frame loop that yields a few
+ * times per frame while waiting on another thread), so SLEEP0_DEFAULT_WORK_CREDIT
+ * yields are taken off its run. Without it a loop running faster than SLEEP0_WINDOW
+ * per frame never starts a new run and every frame gets the sleep (AIO DirectDraw at
+ * ~2800 fps capped to ~1460). A credit instead of a reset: an idle spinner also sees
+ * an occasional long gap (interrupts), which must not end its throttling. It is CPU
+ * time, not wall time, so time spent preempted is not counted as work.
+ * WINE_SLEEP0_THROTTLE=<iters>,<usec>,<work_us>,<credit>; work_us 0 turns it off.
  */
 #define SLEEP0_DEFAULT_ITERS 50000  /* > 100 ms of uninterrupted Sleep(0) */
 #define SLEEP0_DEFAULT_USEC  250
 #define SLEEP0_WINDOW        (2 * TICKSPERSEC / 1000)  /* 2 ms */
+#define SLEEP0_DEFAULT_WORK_USEC   20
+#define SLEEP0_DEFAULT_WORK_CREDIT 1000
 
 static pthread_once_t sleep0_once = PTHREAD_ONCE_INIT;
 static unsigned int sleep0_iters;
 static unsigned int sleep0_usec;
+static ULONGLONG sleep0_work_ns;
+static unsigned int sleep0_work_credit;
 
 static void sleep0_init(void)
 {
     const char *env = getenv( "WINE_SLEEP0_THROTTLE" );
-    unsigned long iters = SLEEP0_DEFAULT_ITERS, usec = SLEEP0_DEFAULT_USEC;
+    unsigned long iters = SLEEP0_DEFAULT_ITERS, usec = SLEEP0_DEFAULT_USEC, work = SLEEP0_DEFAULT_WORK_USEC;
+    unsigned long credit = SLEEP0_DEFAULT_WORK_CREDIT;
     char *end;
 
     if (env && *env)
     {
         iters = strtoul( env, &end, 10 );
-        if (*end == ',' && !(usec = strtoul( end + 1, NULL, 10 ))) usec = SLEEP0_DEFAULT_USEC;
+        if (*end == ',')
+        {
+            if (!(usec = strtoul( end + 1, &end, 10 ))) usec = SLEEP0_DEFAULT_USEC;
+            if (*end == ',')
+            {
+                work = strtoul( end + 1, &end, 10 );
+                if (*end == ',') credit = strtoul( end + 1, NULL, 10 );
+            }
+        }
     }
     if (iters > 0x7fffffff) iters = 0x7fffffff;
     if (usec > 100000) usec = 100000;
     sleep0_iters = iters;
     sleep0_usec = usec;
-    if (env) TRACE( "WINE_SLEEP0_THROTTLE %lu iterations, %lu us\n", iters, usec );
+    if (work > 1000000) work = 1000000;
+    sleep0_work_ns = (ULONGLONG)work * 1000;
+    if (credit > 0x7fffffff) credit = 0x7fffffff;
+    sleep0_work_credit = credit;
+    if (env) TRACE( "WINE_SLEEP0_THROTTLE %lu iterations, %lu us, work credit %lu us %lu\n", iters, usec, work, credit );
 }
 
 static inline void sleep0_reset( const LARGE_INTEGER *timeout )
@@ -2624,6 +2651,15 @@
     if (!sleep0_iters) return;
 
     now = monotonic_counter();
+    if (sleep0_work_ns && !clock_gettime( CLOCK_THREAD_CPUTIME_ID, &ts ))
+    {
+        ULONGLONG cpu = (ULONGLONG)ts.tv_sec * 1000000000 + ts.tv_nsec;
+
+        if (cpu - thread_data->sleep0_cpu > sleep0_work_ns)
+            thread_data->sleep0_count = thread_data->sleep0_count > sleep0_work_credit
+                                        ? thread_data->sleep0_count - sleep0_work_credit : 0;
+        thread_data->sleep0_cpu = cpu;
+    }
     if (now - thread_data->sleep0_last > SLEEP0_WINDOW) thread_data->sleep0_count = 0;
     thread_data->sleep0_last = now;
 
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -120,6 +120,7 @@
     TEB                      *next_killed;   /* next in the list of killed threads to free */
     unsigned int              sleep0_count;  /* consecutive yields that did not switch */
     ULONGLONG                 sleep0_last;   /* time of the last one, in Win32 ticks */
+    ULONGLONG                 sleep0_cpu;    /* thread CPU time at the last one, in ns */
 };
 
 C_ASSERT( sizeof(struct ntdll_thread_data) <= sizeof(((TEB *)0)->GdiTebBatch) );
