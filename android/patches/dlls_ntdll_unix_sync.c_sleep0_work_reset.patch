ntdll: Sleep(0) throttle starts a new run when the thread does frame-loop work between yields.

The GameNative #119 throttle (dlls_ntdll_unix_sync.c_sleep0_yield_throttle.patch) starts a new run only
after a gap of more than 2 ms or a wait with a non-zero timeout. A loop that yields a few times per frame
while waiting on another thread and runs faster than 2 ms per frame never starts a new run, so after 50000
yields every frame gets the 250 us sleep: AIO DirectDraw on the Pocket FIT went from ~2785 to ~1460 fps
(WINE_SLEEP0_THROTTLE=0: 2775/2789).

Work = the thread's own CPU time (CLOCK_THREAD_CPUTIME_ID) since the previous non-switching yield. A new run
also starts after more than 500 us of work, or after two gaps of more than 50 us of work less than 2 ms
apart (a frame loop). An idle Sleep(0) spinner (~1 us per yield on the Pocket FIT) also gets a 20-100 us gap
every 10-50 ms (interrupt/scheduler time charged to the thread); measured there, resetting on each such
gap let idle spinners run at 43-77 % CPU instead of the GN default's 2-4 %, so a single gap is ignored.
Default work limit 50 us, picked on the Pocket FIT (11.0-2, sleeptest.exe + AIO DirectDraw): 20 us kept AIO at
2558 fps but idle spinners at 54 % CPU, 50 us gives 2455 fps and 11 % (GN default: ~1460 fps, 3 %; off: ~2780, 100 %).
WINE_SLEEP0_THROTTLE=<iters>,<usec>,<work_us>,<big_us> (work_us 0 = old behaviour; 50000,250,20,500 = 20 us).

On a Pocket FIT Elite AIO DirectDraw runs at ~9800 fps (0.1 ms frames) with less than 50 us of work per
frame, so it was still capped (50 us: ~4200 fps, GN default 1675). WINE_SLEEP0_THROTTLE_SKIP lists graphics
APIs whose processes are never throttled (dx7 dx8 dx9 dx10 dx11 dx12 gl vk, or "none"), default dx7. The
process's API is taken from the graphics DLLs in /proc/self/maps, once, when a thread first reaches the
throttle (looked up again at most every 5 s while none is listed); one MESSAGE line says what was found.

--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2582,31 +2582,179 @@
  *
  * WINE_SLEEP0_THROTTLE=0 disables it, WINE_SLEEP0_THROTTLE=<iters>[,<usec>] sets
  * the threshold and the sleep length.
+ *
+ * Work: the thread's own CPU time (CLOCK_THREAD_CPUTIME_ID) between two yields. A
+ * loop that yields a few times per frame while waiting on another thread and runs
+ * faster than SLEEP0_WINDOW per frame never started a new run, so every frame got
+ * the sleep (AIO DirectDraw at ~2800 fps capped to ~1460). An idle spinner also sees
+ * a gap of 20-100 us every 10-50 ms (interrupt and scheduler time charged to it), so
+ * one such gap must not end its run. A new run starts after more than
+ * SLEEP0_DEFAULT_BIG_USEC of work, or after two gaps of more than
+ * SLEEP0_DEFAULT_WORK_USEC less than SLEEP0_WORK_PERIOD apart (a frame loop).
+ * WINE_SLEEP0_THROTTLE=<iters>,<usec>,<work_us>,<big_us>; work_us 0 turns it off.
+ *
+ * WINE_SLEEP0_THROTTLE_SKIP: graphics APIs whose processes are never throttled, a
+ * comma list of dx7 dx8 dx9 dx10 dx11 dx12 gl vk, or "none"; default dx7 (DirectDraw
+ * loops run at thousands of fps with too little work per frame to be told apart from
+ * an idle spinner on fast devices). A process's API is the first in sleep0_apis whose
+ * DLL it has mapped; it is looked up when a thread first reaches the throttle.
  */
 #define SLEEP0_DEFAULT_ITERS 50000  /* > 100 ms of uninterrupted Sleep(0) */
 #define SLEEP0_DEFAULT_USEC  250
 #define SLEEP0_WINDOW        (2 * TICKSPERSEC / 1000)  /* 2 ms */
+#define SLEEP0_DEFAULT_WORK_USEC   50
+#define SLEEP0_DEFAULT_BIG_USEC    500
+#define SLEEP0_WORK_PERIOD         (2 * TICKSPERSEC / 1000)  /* 2 ms */
 
 static pthread_once_t sleep0_once = PTHREAD_ONCE_INIT;
 static unsigned int sleep0_iters;
 static unsigned int sleep0_usec;
+static ULONGLONG sleep0_work_ns;
+static ULONGLONG sleep0_big_ns;
+
+static const struct
+{
+    const char *tag, *name, *dll[3];
+} sleep0_apis[] =
+{
+    /* order matters: wrappers load the API below them (d3d8 -> d3d9, d3d10 -> d3d11) */
+    { "dx7",  "DirectX 7",  { "ddraw.dll" } },
+    { "dx8",  "DirectX 8",  { "d3d8.dll" } },
+    { "dx12", "DirectX 12", { "d3d12.dll", "d3d12core.dll" } },
+    { "dx10", "DirectX 10", { "d3d10.dll", "d3d10_1.dll", "d3d10core.dll" } },
+    { "dx11", "DirectX 11", { "d3d11.dll" } },
+    { "dx9",  "DirectX 9",  { "d3d9.dll" } },
+    { "gl",   "OpenGL",     { "opengl32.dll" } },
+    { "vk",   "Vulkan",     { "vulkan-1.dll" } },
+};
+static char sleep0_skip_list[128];
+static int sleep0_skip;               /* this process is never throttled */
+static ULONGLONG sleep0_skip_checked; /* time of the last lookup that found no listed API */
 
 static void sleep0_init(void)
 {
     const char *env = getenv( "WINE_SLEEP0_THROTTLE" );
-    unsigned long iters = SLEEP0_DEFAULT_ITERS, usec = SLEEP0_DEFAULT_USEC;
+    unsigned long iters = SLEEP0_DEFAULT_ITERS, usec = SLEEP0_DEFAULT_USEC, work = SLEEP0_DEFAULT_WORK_USEC;
+    unsigned long big = SLEEP0_DEFAULT_BIG_USEC;
     char *end;
 
     if (env && *env)
     {
         iters = strtoul( env, &end, 10 );
-        if (*end == ',' && !(usec = strtoul( end + 1, NULL, 10 ))) usec = SLEEP0_DEFAULT_USEC;
+        if (*end == ',')
+        {
+            if (!(usec = strtoul( end + 1, &end, 10 ))) usec = SLEEP0_DEFAULT_USEC;
+            if (*end == ',')
+            {
+                work = strtoul( end + 1, &end, 10 );
+                if (*end == ',') big = strtoul( end + 1, NULL, 10 );
+            }
+        }
     }
     if (iters > 0x7fffffff) iters = 0x7fffffff;
     if (usec > 100000) usec = 100000;
     sleep0_iters = iters;
     sleep0_usec = usec;
-    if (env) TRACE( "WINE_SLEEP0_THROTTLE %lu iterations, %lu us\n", iters, usec );
+    if (work > 1000000) work = 1000000;
+    sleep0_work_ns = (ULONGLONG)work * 1000;
+    if (big > 1000000) big = 1000000;
+    sleep0_big_ns = (ULONGLONG)big * 1000;
+    {
+        const char *skip = getenv( "WINE_SLEEP0_THROTTLE_SKIP" );
+        char *p;
+
+        if (!skip) skip = "dx7";
+        if (!strcmp( skip, "none" )) skip = "";
+        snprintf( sleep0_skip_list, sizeof(sleep0_skip_list), "%s", skip );
+        for (p = sleep0_skip_list; *p; p++) if (*p >= 'A' && *p <= 'Z') *p += 'a' - 'A';
+    }
+    if (env) TRACE( "WINE_SLEEP0_THROTTLE %lu iterations, %lu us, work %lu us, big work %lu us\n", iters, usec, work, big );
+}
+
+static BOOL sleep0_name_eq( const char *a, const char *b )
+{
+    for (; *a && *b; a++, b++)
+    {
+        char ca = (*a >= 'A' && *a <= 'Z') ? *a + 'a' - 'A' : *a;
+        char cb = (*b >= 'A' && *b <= 'Z') ? *b + 'a' - 'A' : *b;
+        if (ca != cb) return FALSE;
+    }
+    return !*a && !*b;
+}
+
+static BOOL sleep0_tag_listed( const char *tag )
+{
+    const char *p = sleep0_skip_list;
+    size_t len = strlen( tag );
+
+    while (*p)
+    {
+        while (*p == ',' || *p == ' ') p++;
+        if (!strncmp( p, tag, len ) && (!p[len] || p[len] == ',' || p[len] == ' ')) return TRUE;
+        while (*p && *p != ',') p++;
+    }
+    return FALSE;
+}
+
+/* index into sleep0_apis of the process's graphics API, from /proc/self/maps; -1 if none */
+static int sleep0_process_api(void)
+{
+    char buf[4096], line[1024], *name;
+    unsigned int found = 0, len = 0, j, k;
+    ssize_t n, i;
+    int fd = open( "/proc/self/maps", O_RDONLY | O_CLOEXEC );
+
+    if (fd == -1) return -1;
+    while ((n = read( fd, buf, sizeof(buf) )) > 0)
+    {
+        for (i = 0; i < n; i++)
+        {
+            if (buf[i] != '\n')
+            {
+                if (len < sizeof(line) - 1) line[len++] = buf[i];
+                continue;
+            }
+            line[len] = 0;
+            len = 0;
+            if (!(name = strrchr( line, '/' ))) continue;
+            for (j = 0; j < ARRAY_SIZE(sleep0_apis); j++)
+                for (k = 0; k < ARRAY_SIZE(sleep0_apis[j].dll) && sleep0_apis[j].dll[k]; k++)
+                    if (sleep0_name_eq( name + 1, sleep0_apis[j].dll[k] )) found |= 1u << j;
+        }
+    }
+    close( fd );
+    for (j = 0; j < ARRAY_SIZE(sleep0_apis); j++) if (found & (1u << j)) return j;
+    return -1;
+}
+
+/* called when a thread reaches the throttle; TRUE if this process is never throttled */
+static BOOL sleep0_skip_api(void)
+{
+    static BOOL reported;
+    ULONGLONG now;
+    int api;
+
+    if (sleep0_skip) return TRUE;
+    if (!sleep0_skip_list[0]) return FALSE;
+    now = monotonic_counter();
+    /* a game may load its graphics DLL after a first spin: look again at most every 5 s */
+    if (sleep0_skip_checked && now - sleep0_skip_checked < 5 * (ULONGLONG)TICKSPERSEC) return FALSE;
+    sleep0_skip_checked = now;
+    api = sleep0_process_api();
+    if (api >= 0 && sleep0_tag_listed( sleep0_apis[api].tag ))
+    {
+        sleep0_skip = 1;
+        MESSAGE( "wine: Sleep(0) throttle off in this process: %s (%s is in WINE_SLEEP0_THROTTLE_SKIP=%s)\n",
+                 sleep0_apis[api].name, sleep0_apis[api].tag, sleep0_skip_list );
+        return TRUE;
+    }
+    if (!reported)
+    {
+        reported = TRUE;
+        MESSAGE( "wine: Sleep(0) throttle on in this process: %s (WINE_SLEEP0_THROTTLE_SKIP=%s)\n",
+                 api >= 0 ? sleep0_apis[api].name : "no graphics API", sleep0_skip_list );
+    }
+    return FALSE;
 }
 
 static inline void sleep0_reset( const LARGE_INTEGER *timeout )
@@ -2625,6 +2773,19 @@
     if (!sleep0_iters) return;
 
     now = monotonic_counter();
+    if (sleep0_work_ns && !clock_gettime( CLOCK_THREAD_CPUTIME_ID, &ts ))
+    {
+        ULONGLONG cpu = (ULONGLONG)ts.tv_sec * 1000000000 + ts.tv_nsec;
+        ULONGLONG work = cpu - thread_data->sleep0_cpu;
+
+        if (work > sleep0_work_ns)
+        {
+            if (work > sleep0_big_ns || now - thread_data->sleep0_work_last < SLEEP0_WORK_PERIOD)
+                thread_data->sleep0_count = 0;
+            thread_data->sleep0_work_last = now;
+        }
+        thread_data->sleep0_cpu = cpu;
+    }
     if (now - thread_data->sleep0_last > SLEEP0_WINDOW) thread_data->sleep0_count = 0;
     thread_data->sleep0_last = now;
 
@@ -2637,6 +2798,11 @@
     {
         static BOOL warned;
 
+        if (sleep0_skip_api())
+        {
+            thread_data->sleep0_count = 0;
+            return;
+        }
         thread_data->sleep0_count++;
         TRACE( "thread %04x Sleep(0) storm after %u calls, sleeping %u us per call\n",
                (int)GetCurrentThreadId(), sleep0_iters, sleep0_usec );
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -119,6 +119,8 @@
     int                      *fsync_apc_futex;
     unsigned int              sleep0_count;  /* consecutive yields that did not switch */
     ULONGLONG                 sleep0_last;   /* time of the last one, in Win32 ticks */
+    ULONGLONG                 sleep0_cpu;    /* thread CPU time at the last one, in ns */
+    ULONGLONG                 sleep0_work_last; /* time of the last work gap, in Win32 ticks */
