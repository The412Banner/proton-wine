-    static const DWORD source_flags = DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE | DISPLAY_DEVICE_VGA_COMPATIBLE;
+    /* Bionic/arm64ec display fix: a driver-less process (services.exe / plugplay /
+     * wineboot / setup device installers, all in the interactive station during boot)
+     * reaches this fallback because winex11.drv is not loaded in it (pUpdateDisplayDevices
