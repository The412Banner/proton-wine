     if (ctx->is_primary) ctx->primary = *current;
@@ -2227,7 +2237,7 @@ static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEV
     if (modes_count > 1 || current == &detached)
     {
         reg_delete_value( source->key, physicalW );
