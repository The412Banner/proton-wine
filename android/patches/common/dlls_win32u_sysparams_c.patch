+     * Do NOT claim PRIMARY here: keep the source ATTACHED (monitor still registers, so
+     * device/monitor path lookups keep working) but let the winex11-backed process own the
+     * primary. If nothing else ever supplies a primary the source still resolves; the first
+     * real winex11 enumeration promotes its own source to primary. */
+    DWORD source_flags = DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_VGA_COMPATIBLE;
     struct pci_id pci_id = {0};
