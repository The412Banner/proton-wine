@@ -2690,11 +2700,27 @@ static NTSTATUS default_update_display_devices( struct device_manager_ctx *ctx )
           .dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT | DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY,
