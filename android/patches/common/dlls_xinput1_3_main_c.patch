+/* Bannerlator: MsgWaitForMultipleObjectsEx can return a TRANSIENT WAIT_FAILED -- observed
+ * on Android as an esync ppoll EAGAIN under WINEESYNC=1. Upstream drops out of the update
+ * loop and calls FreeLibraryAndExitThread, which permanently stops XInput polling: every
+ * pad AND the emulated on-screen controller go dead for the rest of the session and cannot
+ * be re-acquired, because the input devices are only enumerated at boot. Absorb a bounded
+ * number of these, re-enumerating as if the wait had timed out, and only give up if they
+ * keep coming (so a genuinely dead wait still terminates instead of spinning). */
+#define XINPUT_MAX_TRANSIENT_WAIT_FAILURES 100
+
+static BOOL retry_transient_wait_failure( DWORD *ret, DWORD *failures )
+{
+    if (*ret != WAIT_FAILED) return FALSE;
+    if (++*failures > XINPUT_MAX_TRANSIENT_WAIT_FAILURES) return FALSE;
+    ERR("transient wait failure in the update thread (%lu/%u), error %lu - retrying\n",
+        *failures, XINPUT_MAX_TRANSIENT_WAIT_FAILURES, GetLastError());
+    Sleep(50);
+    *ret = WAIT_TIMEOUT;
+    return TRUE;
+}
+
 static DWORD WINAPI hid_update_thread_proc(void *param)
 {
