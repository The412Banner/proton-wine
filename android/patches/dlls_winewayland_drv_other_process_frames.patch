+
+/**********************************************************************
+ *          Other process rendering
+ *
+ * Wayland has no way to put one client's surface inside another client's window, so a
+ * Vulkan swapchain that one Wine process creates for a window owned by another (Chromium's
+ * GPU process drawing into the browser's window: EA app, Steam, other CEF launchers) gets
+ * a wl_surface the compositor never shows. win32u reads such frames back into a DIB (see
+ * readback_init in win32u/vulkan.c); the drawing process copies the DIB into a section
+ * shared with the window's owner and posts WM_WAYLAND_XPROC_FRAME, and the owner shows the
+ * pixels in a subsurface of its toplevel over that window's client area.
+ */
+
+#define XPROC_MAGIC 0x43525058  /* "XPRC" */
+
+struct xproc_header
+{
+    UINT magic;
+    UINT width;
+    UINT height;
+    UINT stride;
+    LONG seq;      /* odd while the drawing process writes the pixels */
+    LONG pending;  /* a WM_WAYLAND_XPROC_FRAME is queued for the owner */
+    UINT reserved[2];
+};
+
+struct xproc_sender
+{
+    HWND hwnd;
+    DWORD owner_pid;
+    HANDLE section;
+    struct xproc_header *view;
+    SIZE_T view_size;
+    UINT width, height, stride;
+    HANDLE remote;  /* the section duplicated into the owner, not sent yet */
+};
+
+static pthread_mutex_t xproc_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct xproc_sender xproc_senders[8];
+
+static void xproc_sender_free(struct xproc_sender *sender)
+{
+    if (sender->view) NtUnmapViewOfSection(GetCurrentProcess(), sender->view);
+    if (sender->section) NtClose(sender->section);
+    memset(sender, 0, sizeof(*sender));
+}
+
+static BOOL xproc_sender_init(struct xproc_sender *sender, HWND hwnd, DWORD pid,
+                              UINT width, UINT height, UINT stride)
+{
+    LARGE_INTEGER section_size;
+    OBJECT_ATTRIBUTES attr;
+    CLIENT_ID cid;
+    HANDLE process;
+    NTSTATUS status;
+
+    section_size.QuadPart = sizeof(struct xproc_header) + (SIZE_T)stride * height;
+    if ((status = NtCreateSection(&sender->section, SECTION_ALL_ACCESS, NULL, &section_size,
+                                  PAGE_READWRITE, SEC_COMMIT, 0)))
+        goto failed;
+    if ((status = NtMapViewOfSection(sender->section, GetCurrentProcess(), (void **)&sender->view, 0, 0,
+                                     NULL, &sender->view_size, ViewUnmap, 0, PAGE_READWRITE)))
+    {
+        sender->view = NULL;
+        goto failed;
+    }
+
+    InitializeObjectAttributes(&attr, NULL, 0, NULL, NULL);
+    cid.UniqueProcess = ULongToHandle(pid);
+    cid.UniqueThread = 0;
+    if ((status = NtOpenProcess(&process, PROCESS_DUP_HANDLE, &attr, &cid))) goto failed;
+    status = NtDuplicateObject(GetCurrentProcess(), sender->section, process, &sender->remote,
+                               SECTION_MAP_READ | SECTION_MAP_WRITE | SECTION_QUERY, 0, 0);
+    NtClose(process);
+    if (status) goto failed;
+
+    sender->hwnd = hwnd;
+    sender->owner_pid = pid;
+    sender->width = width;
+    sender->height = height;
+    sender->stride = stride;
+    sender->view->magic = XPROC_MAGIC;
+    sender->view->width = width;
+    sender->view->height = height;
+    sender->view->stride = stride;
+    TRACE("hwnd %p owner %04x %ux%u section %p\n", hwnd, (int)pid, width, height, sender->section);
+    return TRUE;
+
+failed:
+    ERR("hwnd %p owner %04x %ux%u: shared frame setup failed, status %#x\n", hwnd, (int)pid,
+        width, height, (int)status);
+    xproc_sender_free(sender);
+    return FALSE;
+}
+
+/***********************************************************************
+ *          wayland_xproc_send
+ *
+ * Called in the drawing process with the read-back frame of a swapchain on hwnd.
+ * Returns FALSE when hwnd belongs to this process or the frame can't be handed over.
+ */
+BOOL wayland_xproc_send(HWND hwnd, HDC hdc)
+{
+    struct xproc_sender *sender = NULL;
+    UINT width, height, stride, i;
+    HBITMAP bitmap;
+    DIBSECTION dib;
+    DWORD pid = 0;
+    HANDLE remote;
+    BOOL post;
+
+    if (!NtUserGetWindowThread(hwnd, &pid) || pid == GetCurrentProcessId()) return FALSE;
+    if (!(bitmap = NtGdiGetDCObject(hdc, NTGDI_OBJ_SURF)) ||
+        NtGdiExtGetObjectW(bitmap, sizeof(dib), &dib) != sizeof(dib) ||
+        !dib.dsBm.bmBits || dib.dsBm.bmBitsPixel != 32)
+        return FALSE;
+    width = dib.dsBm.bmWidth;
+    height = dib.dsBm.bmHeight;
+    stride = dib.dsBm.bmWidthBytes;
+    if (!width || !height || width > 0xffff || height > 0xffff || stride < width * 4) return FALSE;
+
+    pthread_mutex_lock(&xproc_mutex);
+    for (i = 0; i < ARRAY_SIZE(xproc_senders) && !sender; i++)
+        if (xproc_senders[i].hwnd == hwnd) sender = &xproc_senders[i];
+    for (i = 0; i < ARRAY_SIZE(xproc_senders) && !sender; i++)
+        if (!xproc_senders[i].hwnd) sender = &xproc_senders[i];
+    if (!sender) xproc_sender_free((sender = &xproc_senders[0]));
+    if (sender->hwnd && (sender->owner_pid != pid || sender->width != width ||
+                         sender->height != height || sender->stride != stride))
+        xproc_sender_free(sender);
+    if (!sender->section && !xproc_sender_init(sender, hwnd, pid, width, height, stride))
+    {
+        pthread_mutex_unlock(&xproc_mutex);
+        return FALSE;
+    }
+
+    __atomic_add_fetch(&sender->view->seq, 1, __ATOMIC_ACQ_REL);
+    memcpy(sender->view + 1, dib.dsBm.bmBits, (SIZE_T)stride * height);
+    __atomic_add_fetch(&sender->view->seq, 1, __ATOMIC_RELEASE);
+
+    remote = sender->remote;
+    sender->remote = 0;
+    post = !__atomic_exchange_n(&sender->view->pending, 1, __ATOMIC_ACQ_REL) || remote;
+    pthread_mutex_unlock(&xproc_mutex);
+
+    if (post && !NtUserPostMessage(hwnd, WM_WAYLAND_XPROC_FRAME, MAKEWPARAM(width, height),
+                                   (LPARAM)remote))
+    {
+        WARN("hwnd %p is gone, dropping its shared frame\n", hwnd);
+        pthread_mutex_lock(&xproc_mutex);
+        if (sender->hwnd == hwnd) xproc_sender_free(sender);
+        pthread_mutex_unlock(&xproc_mutex);
+    }
+    return TRUE;
+}
+
+struct wayland_xproc_surface
+{
+    HWND toplevel;
+    struct wl_surface *parent;  /* the toplevel's wl_surface our subsurface belongs to */
+    HANDLE section;
+    struct xproc_header *view;
+    SIZE_T view_size;
+    struct wl_surface *wl_surface;
+    struct wl_subsurface *wl_subsurface;
+    struct wp_viewport *wp_viewport;
+    int x, y, width, height;  /* last subsurface position and size, in surface coordinates */
+    BOOL mapped;
+};
+
+static void xproc_buffer_release(void *data, struct wl_buffer *buffer)
+{
+    wayland_shm_buffer_unref(data);
+}
+
+static const struct wl_buffer_listener xproc_buffer_listener =
+{
+    xproc_buffer_release
+};
+
+void wayland_xproc_hide(struct wayland_xproc_surface *xproc)
+{
+    if (!xproc || !xproc->mapped) return;
+    wl_surface_attach(xproc->wl_surface, NULL, 0, 0);
+    wl_surface_commit(xproc->wl_surface);
+    xproc->mapped = FALSE;
+}
+
+void wayland_xproc_destroy(struct wayland_xproc_surface *xproc)
+{
+    if (!xproc) return;
+    if (xproc->wp_viewport) wp_viewport_destroy(xproc->wp_viewport);
+    if (xproc->wl_subsurface) wl_subsurface_destroy(xproc->wl_subsurface);
+    if (xproc->wl_surface) wl_surface_destroy(xproc->wl_surface);
+    if (xproc->view) NtUnmapViewOfSection(GetCurrentProcess(), xproc->view);
+    if (xproc->section) NtClose(xproc->section);
+    free(xproc);
+}
+
+static BOOL xproc_surface_create(struct wayland_xproc_surface *xproc)
+{
+    struct wl_region *empty_region;
+
+    if (!(xproc->wl_surface = wl_compositor_create_surface(process_wayland.wl_compositor))) return FALSE;
+    /* input stays with the window underneath, which belongs to this process */
+    if ((empty_region = wl_compositor_create_region(process_wayland.wl_compositor)))
+    {
+        wl_surface_set_input_region(xproc->wl_surface, empty_region);
+        wl_region_destroy(empty_region);
+    }
+    if (!(xproc->wp_viewport = wp_viewporter_get_viewport(process_wayland.wp_viewporter, xproc->wl_surface)))
+        return FALSE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *          wayland_xproc_frame
+ *
+ * WM_WAYLAND_XPROC_FRAME handler, in the process owning hwnd. wp is the frame size, lp the
+ * section handle when the drawing process (re)created it.
+ */
+void wayland_xproc_frame(HWND hwnd, WPARAM wp, LPARAM lp)
+{
+    UINT width = LOWORD(wp), height = HIWORD(wp), dpi, row, tries;
+    HWND toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct wayland_win_data *data, *toplevel_data;
+    struct wayland_shm_buffer *shm_buffer;
+    struct wayland_xproc_surface *xproc;
+    struct wayland_surface *surface;
+    struct xproc_header *header;
+    int client_x, client_y, x, y, w, h;
+    LONG seq;
+    RECT rect;
+
+    if (!(data = wayland_win_data_get(hwnd)))
+    {
+        if (lp) NtClose((HANDLE)lp);
+        return;
+    }
+    if (!(xproc = data->xproc) && !(xproc = data->xproc = calloc(1, sizeof(*xproc))))
+    {
+        if (lp) NtClose((HANDLE)lp);
+        goto done;
+    }
+
+    if (lp)
+    {
+        if (xproc->view) NtUnmapViewOfSection(GetCurrentProcess(), xproc->view);
+        if (xproc->section) NtClose(xproc->section);
+        xproc->view = NULL;
+        xproc->view_size = 0;
+        xproc->section = (HANDLE)lp;
+        if (NtMapViewOfSection(xproc->section, GetCurrentProcess(), (void **)&xproc->view, 0, 0, NULL,
+                               &xproc->view_size, ViewUnmap, 0, PAGE_READWRITE))
+            xproc->view = NULL;
+    }
+
+    if (!(header = xproc->view)) goto done;
+    if (header->magic != XPROC_MAGIC || header->width != width || header->height != height ||
+        header->stride < width * 4 ||
+        xproc->view_size < sizeof(*header) + (SIZE_T)header->stride * height)
+        goto done;
+    /* frames drawn from now on need a new message */
+    __atomic_store_n(&header->pending, 0, __ATOMIC_RELEASE);
+
+    toplevel_data = toplevel ? wayland_win_data_get_nolock(toplevel) : NULL;
+    surface = toplevel_data ? toplevel_data->wayland_surface : NULL;
+    if (!surface || !NtUserIsWindowVisible(hwnd))
+    {
+        wayland_xproc_hide(xproc);
+        goto done;
+    }
+
+    if (!xproc->wl_surface && !xproc_surface_create(xproc))
+    {
+        ERR("hwnd %p: failed to create the shared frame surface\n", hwnd);
+        goto done;
+    }
+    if (xproc->toplevel != toplevel || xproc->parent != surface->wl_surface || !xproc->wl_subsurface)
+    {
+        if (xproc->wl_subsurface) wl_subsurface_destroy(xproc->wl_subsurface);
+        /* a new subsurface starts on top of its siblings, above the toplevel's own client surface */
+        if (!(xproc->wl_subsurface = wl_subcompositor_get_subsurface(process_wayland.wl_subcompositor,
+                                                                     xproc->wl_surface, surface->wl_surface)))
+        {
+            ERR("hwnd %p: failed to create the shared frame subsurface\n", hwnd);
+            goto done;
+        }
+        wl_subsurface_set_desync(xproc->wl_subsurface);
+        xproc->toplevel = toplevel;
+        xproc->parent = surface->wl_surface;
+        xproc->x = xproc->y = INT_MIN;
+        xproc->width = xproc->height = 0;
+    }
+
+    if (!(shm_buffer = wayland_shm_buffer_create(width, height, WL_SHM_FORMAT_XRGB8888))) goto done;
+    /* retry while the drawing process rewrites the frame; the last try keeps a torn frame
+     * rather than an empty buffer */
+    for (tries = 0; ; tries++)
+    {
+        seq = __atomic_load_n(&header->seq, __ATOMIC_ACQUIRE);
+        if ((seq & 1) && tries < 3) continue;
+        for (row = 0; row < height; row++)
+            memcpy((char *)shm_buffer->map_data + (SIZE_T)row * width * 4,
+                   (char *)(header + 1) + (SIZE_T)row * header->stride, width * 4);
+        if (__atomic_load_n(&header->seq, __ATOMIC_ACQUIRE) == seq || tries >= 3) break;
+    }
+    wl_buffer_add_listener(shm_buffer->wl_buffer, &xproc_buffer_listener, shm_buffer);
+
+    /* the window's client area, relative to the toplevel window's origin */
+    dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    NtUserGetClientRect(hwnd, &rect, dpi);
+    NtUserMapWindowPoints(hwnd, toplevel, (POINT *)&rect, 2, dpi);
+    client_x = rect.left + surface->window.client_rect.left - surface->window.rect.left;
+    client_y = rect.top + surface->window.client_rect.top - surface->window.rect.top;
+    wayland_surface_coords_from_window(surface, client_x, client_y, &x, &y);
+    wayland_surface_coords_from_window(surface, rect.right - rect.left, rect.bottom - rect.top, &w, &h);
+    if (w <= 0 || h <= 0)
+    {
+        w = width;
+        h = height;
+    }
+    if (w != xproc->width || h != xproc->height)
+    {
+        wp_viewport_set_destination(xproc->wp_viewport, w, h);
+        xproc->width = w;
+        xproc->height = h;
+    }
+
+    wl_surface_attach(xproc->wl_surface, shm_buffer->wl_buffer, 0, 0);
+    wl_surface_damage_buffer(xproc->wl_surface, 0, 0, width, height);
+    wl_surface_commit(xproc->wl_surface);
+    xproc->mapped = TRUE;
+
+    if (x != xproc->x || y != xproc->y)
+    {
+        TRACE("hwnd %p toplevel %p frame %ux%u at %d,%d+%dx%d\n", hwnd, toplevel, width, height, x, y, w, h);
+        wl_subsurface_set_position(xproc->wl_subsurface, x, y);
+        xproc->x = x;
+        xproc->y = y;
+        /* subsurface position is parent state */
+        wl_surface_commit(surface->wl_surface);
+    }
+    wl_display_flush(process_wayland.wl_display);
+
+done:
+    wayland_win_data_release(data);
+}
