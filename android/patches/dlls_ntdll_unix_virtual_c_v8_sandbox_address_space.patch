+#ifdef __ANDROID__
+/* Android kernels give 64-bit processes a 39-bit (512 GB) user address space. V8 in
+ * Chromium-based programs with the V8 sandbox (Chrome / CEF 128 and newer, e.g. the EA app
+ * 13.836 renderers) checks that the address space reported by GetSystemInfo is larger than
+ * its 1 TB sandbox and deliberately crashes otherwise (CHECK_LT(kSandboxSize,
+ * address_space_limit), int3). Past that check V8 falls back to a partially reserved sandbox
+ * that fits in 512 GB. So report a 41-bit limit to Chromium child processes ("--type=" on the
+ * command line: renderer, utility, gpu). Only the reported value changes: Wine still allocates
+ * within the real limit, and address requirements up to the reported limit are clamped (see
+ * get_extended_params). WINE_LARGE_ADDRESS_REPORT=1 reports it to every 64-bit process, =0 to
+ * none. */
+#define ANDROID_REPORTED_SPACE_LIMIT ((ULONG_PTR)1 << 41)
+
+static BOOL unicode_has_ascii( const UNICODE_STRING *str, const char *needle )
+{
+    size_t n = strlen( needle ), len, i, j;
+
+    if (!str || !str->Buffer) return FALSE;
+    len = str->Length / sizeof(WCHAR);
+    for (i = 0; i + n <= len; i++)
+    {
+        for (j = 0; j < n; j++) if (str->Buffer[i + j] != (WCHAR)(unsigned char)needle[j]) break;
+        if (j == n) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL android_large_address_report(void)
+{
+    static int enabled = -1;
+    const char *env;
+
+    if (enabled != -1) return enabled;
+    if (!is_win64 || (ULONG_PTR)user_space_limit >= ANDROID_REPORTED_SPACE_LIMIT) return (enabled = FALSE);
+    if ((env = getenv( "WINE_LARGE_ADDRESS_REPORT" )) && *env) enabled = !!atoi( env );
+    else if (!peb || !peb->ProcessParameters) return FALSE;  /* too early to tell, decide later */
+    else enabled = unicode_has_ascii( &peb->ProcessParameters->CommandLine, "--type=" );
+    if (enabled) FIXME( "HACK: reporting a %#lx user address space (real limit %p) for the V8 sandbox.\n",
+                        (unsigned long)ANDROID_REPORTED_SPACE_LIMIT, user_space_limit );
+    return enabled;
+}
+#endif
+
+/***********************************************************************
+ *           virtual_get_reported_system_info
+ *
+ * SystemBasicInformation as reported to programs.
+ */
+void virtual_get_reported_system_info( SYSTEM_BASIC_INFORMATION *info, BOOL wow64 )
+{
+    virtual_get_system_info( info, wow64 );
+#ifdef __ANDROID__
+    if (!wow64 && android_large_address_report())
+        info->HighestUserAddress = (void *)(ANDROID_REPORTED_SPACE_LIMIT - 0x10000 - 1);
+#endif
+}
+
 
