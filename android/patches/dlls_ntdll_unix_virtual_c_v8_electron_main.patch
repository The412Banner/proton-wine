     else if (!peb || !peb->ProcessParameters) return FALSE;  /* too early to tell, decide later */
-    else enabled = unicode_has_ascii( &peb->ProcessParameters->CommandLine, "--type=" );
+    else enabled = unicode_has_ascii( &peb->ProcessParameters->CommandLine, "--type=" ) || main_exe_is_electron();
