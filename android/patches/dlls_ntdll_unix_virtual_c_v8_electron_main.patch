+/* Electron apps (Vortex, ...) run V8 - with its sandbox - in the main process too, which has no
+ * "--type=" switch; they ship their code as resources\app.asar next to the exe. */
+static BOOL main_exe_is_electron(void)
+{
+    static const WCHAR prefixW[] = {'\\','?','?','\\'};
+    static const WCHAR asarW[] = {'\\','r','e','s','o','u','r','c','e','s','\\','a','p','p','.','a','s','a','r'};
+    const UNICODE_STRING *image = &peb->ProcessParameters->ImagePathName;
+    FILE_BASIC_INFORMATION info;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    WCHAR buffer[MAX_PATH + 32];
+    unsigned int len = image->Length / sizeof(WCHAR), start = 0, dir;
+
+    if (!image->Buffer || !len) return FALSE;
+    /* "\\?\C:\..." or "\??\C:\...": drop the prefix, the NT one is added below */
+    if (len > 4 && image->Buffer[0] == '\\' && (image->Buffer[1] == '\\' || image->Buffer[1] == '?')
+            && image->Buffer[2] == '?' && image->Buffer[3] == '\\') start = 4;
+    for (dir = len; dir > start && image->Buffer[dir - 1] != '\\'; dir--) ;
+    if (dir <= start + 1 || ARRAY_SIZE(prefixW) + dir - 1 - start + ARRAY_SIZE(asarW) >= ARRAY_SIZE(buffer)) return FALSE;
+    memcpy( buffer, prefixW, sizeof(prefixW) );
+    memcpy( buffer + ARRAY_SIZE(prefixW), image->Buffer + start, (dir - 1 - start) * sizeof(WCHAR) );
+    memcpy( buffer + ARRAY_SIZE(prefixW) + dir - 1 - start, asarW, sizeof(asarW) );
+    name.Buffer = buffer;
+    name.Length = name.MaximumLength = (ARRAY_SIZE(prefixW) + dir - 1 - start + ARRAY_SIZE(asarW)) * sizeof(WCHAR);
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    return !NtQueryAttributesFile( &attr, &info );
+}
