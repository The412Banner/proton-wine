+/*
+ * The Wine glass of the Windows 10 style start button and desktop background: drawn four times
+ * larger with GDI and averaged down, so that it has smooth edges at any size. The glass, its stem
+ * and its foot are solid, the wine is translucent.
+ */
+
+static void glass_point( POINT *pts, int *count, double k, double x, double y )
+{
+    pts[*count].x = (LONG)(x * k + 0.5);
+    pts[*count].y = (LONG)(y * k + 0.5);
+    (*count)++;
+}
+
+static void glass_curve( POINT *pts, int *count, double k, double x0, double y0, double x1, double y1,
+                         double x2, double y2, double x3, double y3 )
+{
+    int i;
+
+    for (i = 1; i <= 12; i++)
+    {
+        double t = i / 12.0, u = 1.0 - t;
+
+        glass_point( pts, count, k, u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3,
+                     u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3 );
+    }
+}
+
+/* coverage of the glass in a size x size square, 0 to 255, free() it after use; bold draws
+ * thicker lines and solid wine, for small sizes such as the start button */
+static BYTE *render_wine_glass( int size, BOOL bold )
+{
+    BITMAPINFO info;
+    int big = size * 4, count, x, y, sx, sy;
+    double k = big / 64.0;
+    HGDIOBJ old_bitmap, old_pen, old_brush;
+    HBITMAP bitmap;
+    HBRUSH brush;
+    LOGBRUSH lb;
+    POINT pts[40];
+    DWORD *bits;
+    BYTE *alpha;
+    HPEN pen;
+    HDC hdc;
+
+    if (size <= 0 || !(alpha = calloc( size, size ))) return NULL;
+    memset( &info, 0, sizeof(info) );
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = big;
+    info.bmiHeader.biHeight = -big;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(hdc = CreateCompatibleDC( 0 )))
+    {
+        free( alpha );
+        return NULL;
+    }
+    if (!(bitmap = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 )))
+    {
+        DeleteDC( hdc );
+        free( alpha );
+        return NULL;
+    }
+    old_bitmap = SelectObject( hdc, bitmap );
+    memset( bits, 0, big * big * sizeof(*bits) );
+
+    /* the wine, in the green channel */
+    brush = CreateSolidBrush( RGB(0x00,0xff,0x00) );
+    old_brush = SelectObject( hdc, brush );
+    old_pen = SelectObject( hdc, GetStockObject( NULL_PEN ));
+    count = 0;
+    glass_point( pts, &count, k, 21.6, 17.5 );
+    glass_point( pts, &count, k, 42.4, 17.5 );
+    glass_curve( pts, &count, k, 42.4, 17.5, 41.5, 26.0, 37.2, 32.9, 32.0, 34.0 );
+    glass_curve( pts, &count, k, 32.0, 34.0, 26.8, 32.9, 22.5, 26.0, 21.6, 17.5 );
+    Polygon( hdc, pts, count );
+    SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    DeleteObject( brush );
+
+    /* the glass, its stem and foot, in the red channel */
+    lb.lbStyle = BS_SOLID;
+    lb.lbColor = RGB(0xff,0x00,0x00);
+    lb.lbHatch = 0;
+    pen = ExtCreatePen( PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_ROUND | PS_JOIN_ROUND, (DWORD)((bold ? 5.6 : 3.2) * k + 0.5), &lb, 0, NULL );
+    SelectObject( hdc, pen );
+    count = 0;
+    glass_point( pts, &count, k, 19.0, 5.0 );
+    glass_point( pts, &count, k, 45.0, 5.0 );
+    glass_point( pts, &count, k, 42.8, 22.0 );
+    glass_curve( pts, &count, k, 42.8, 22.0, 41.5, 32.0, 36.5, 37.5, 32.0, 38.5 );
+    glass_curve( pts, &count, k, 32.0, 38.5, 27.5, 37.5, 22.5, 32.0, 21.2, 22.0 );
+    Polygon( hdc, pts, count );
+    MoveToEx( hdc, (int)(32.0 * k), (int)(38.5 * k), NULL );
+    LineTo( hdc, (int)(32.0 * k), (int)(54.0 * k) );
+    MoveToEx( hdc, (int)(21.0 * k), (int)(58.5 * k), NULL );
+    LineTo( hdc, (int)(43.0 * k), (int)(58.5 * k) );
+    SelectObject( hdc, old_pen );
+    SelectObject( hdc, old_brush );
+    DeleteObject( pen );
+    GdiFlush();
+
+    for (y = 0; y < size; y++)
+    {
+        for (x = 0; x < size; x++)
+        {
+            unsigned int solid = 0, wine = 0;
+
+            for (sy = 0; sy < 4; sy++)
+            {
+                const DWORD *row = bits + (y * 4 + sy) * big + x * 4;
+
+                for (sx = 0; sx < 4; sx++)
+                {
+                    solid += (row[sx] >> 16) & 0xff;
+                    wine += (row[sx] >> 8) & 0xff;
+                }
+            }
+            solid /= 16;
+            wine = bold ? wine / 16 : wine / 16 * 55 / 100;
+            alpha[y * size + x] = max( solid, wine );
+        }
+    }
+
+    SelectObject( hdc, old_bitmap );
+    DeleteObject( bitmap );
+    DeleteDC( hdc );
+    return alpha;
+}
+
+static COLORREF blend_pixel( COLORREF dst, COLORREF src, unsigned int alpha )
+{
+    return RGB( GetRValue(dst) + ((int)GetRValue(src) - (int)GetRValue(dst)) * (int)alpha / 255,
+                GetGValue(dst) + ((int)GetGValue(src) - (int)GetGValue(dst)) * (int)alpha / 255,
+                GetBValue(dst) + ((int)GetBValue(src) - (int)GetBValue(dst)) * (int)alpha / 255 );
+}
+
+/* paint 'color' with the given coverage over what is already in the size x size square at x,y */
+static void draw_coverage( HDC hdc, int x, int y, int size, const BYTE *alpha, COLORREF color )
+{
+    BITMAPINFO info;
+    HGDIOBJ old_bitmap;
+    HBITMAP bitmap;
+    DWORD *bits;
+    HDC mem;
+    int i;
+
+    if (!alpha || size <= 0 || !(mem = CreateCompatibleDC( hdc ))) return;
+    memset( &info, 0, sizeof(info) );
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = size;
+    info.bmiHeader.biHeight = -size;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(bitmap = CreateDIBSection( mem, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 )))
+    {
+        DeleteDC( mem );
+        return;
+    }
+    old_bitmap = SelectObject( mem, bitmap );
+    BitBlt( mem, 0, 0, size, size, hdc, x, y, SRCCOPY );
+    GdiFlush();
+    for (i = 0; i < size * size; i++)
+    {
+        /* DIB pixels are 0x00RRGGBB, a COLORREF is 0x00BBGGRR */
+        COLORREF dst = RGB( (bits[i] >> 16) & 0xff, (bits[i] >> 8) & 0xff, bits[i] & 0xff );
+
+        if (!alpha[i]) continue;
+        dst = blend_pixel( dst, color, alpha[i] );
+        bits[i] = (GetRValue(dst) << 16) | (GetGValue(dst) << 8) | GetBValue(dst);
+    }
+    BitBlt( hdc, x, y, size, size, mem, 0, 0, SRCCOPY );
+    SelectObject( mem, old_bitmap );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+}
+
+/* the background of a taskbar part: lighter under the pointer, as on Windows 10 */
+static COLORREF win10_part_color( BOOL down, BOOL hot )
+{
+    if (down) return hot ? WIN10_HOT_HOVER : WIN10_HOT;
+    return hot ? WIN10_HOVER : WIN10_BAR;
+}
+
+static void win10_draw_start_button( HDC hdc, int width, int height, BOOL down, BOOL hot )
+{
+    int size = xp_scale( 22 );
+
+    fill_solid( hdc, 0, 0, width, height, win10_part_color( down, hot ));
+    if (!start_glyph || start_glyph_size != size)
+    {
+        free( start_glyph );
+        start_glyph = render_wine_glass( size, TRUE );
+        start_glyph_size = size;
+    }
+    draw_coverage( hdc, (width - size) / 2, (height - size) / 2, size, start_glyph, RGB(0xff,0xff,0xff) );
+}
