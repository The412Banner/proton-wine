+/*
+ * Windows 10 style start menu, used with the win10 taskbar: a rail of icons on the left and the
+ * programs of both start menus in alphabetical order under letter headings, folders open in
+ * place. Painted by hand like the Luna start menu.
+ */
+
+enum w10_rail
+{
+    W10_RAIL_MENU,           /* at the top, shows the names next to the icons */
+    W10_RAIL_USER,
+    W10_RAIL_DOCUMENTS,
+    W10_RAIL_PICTURES,
+    W10_RAIL_SETTINGS,
+    W10_RAIL_POWER,
+    W10_RAIL_COUNT
+};
+
+enum w10_action
+{
+    W10_NONE,
+    W10_LAUNCH,
+    W10_FOLDER,
+    W10_RUN,
+    W10_SHUT_DOWN,
+    W10_SETTINGS,
+};
+
+struct w10_node
+{
+    WCHAR name[MAX_PATH];
+    WCHAR path[MAX_PATH];    /* the file, or the directory of a folder */
+    WCHAR path2[MAX_PATH];   /* the same folder in the other start menu */
+    BOOL  folder;
+    BOOL  loaded;            /* the children are listed */
+    BOOL  expanded;
+    BOOL  run;               /* the Run entry of the Wine System folder */
+    BOOL  icon_loaded;
+    HICON icon;
+    struct w10_node *children;
+    unsigned int     child_count;
+};
+
+struct w10_row
+{
+    struct w10_node *node;   /* NULL for a letter heading */
+    WCHAR letter;
+    int   depth;
+    int   top;               /* in list coordinates */
+};
+
+#define W10_BACK       RGB(0x1f,0x1f,0x1f)
+#define W10_RAIL_BACK  RGB(0x2b,0x2b,0x2b)
+#define W10_HOT_BACK   RGB(0x3a,0x3a,0x3a)
+#define W10_TEXT       RGB(0xff,0xff,0xff)
+#define W10_SCROLL     RGB(0x6a,0x6a,0x6a)
+#define W10_MAX_TILES  12
+
+/* the tiles on the right: Wine's tools and the shortcuts of the desktop, launched by a click */
+struct w10_tile
+{
+    WCHAR name[MAX_PATH];
+    WCHAR path[MAX_PATH];
+    HICON icon;
+    RECT  rect;
+};
+
+static struct w10_tile w10_tiles[W10_MAX_TILES];
+static unsigned int w10_tile_count;
+static int  w10_hot_tile = -1;
+static int  w10_list_right;        /* right edge of the program list, the tiles are beyond it */
+static RECT w10_group_rects[2];    /* where the two group names are written */
+static BOOL w10_list_hover;        /* the pointer is over the list: the thin scroll bar shows */
+static HFONT w10_small_font;
+
+static struct w10_node w10_root;
+static struct w10_row *w10_rows;
+static unsigned int w10_row_count, w10_row_capacity;
+static int  w10_content_height, w10_scroll, w10_width, w10_height;
+static int  w10_hot_row = -1, w10_hot_rail = -1;
+static BOOL w10_rail_wide, w10_done, w10_in_popup, w10_button_down, w10_dragging;
+static POINT w10_down_pt;
+static int  w10_down_scroll;
+static UINT w10_dpi = USER_DEFAULT_SCREEN_DPI;
+static HWND w10_window, w10_tray;
+static HFONT w10_font;
+static HICON w10_folder_icon;
+static WCHAR w10_user[64];
+static enum w10_action w10_action;
+static int  w10_action_csidl;
+static WCHAR w10_action_path[MAX_PATH];
+
+static int w10_px( int size )
+{
+    return MulDiv( size, w10_dpi, USER_DEFAULT_SCREEN_DPI );
+}
+
+static int w10_row_height(void)   { return w10_px( 36 ); }
+static int w10_rail_item(void)    { return w10_px( 48 ); }
+static int w10_rail_width(void)   { return w10_rail_wide ? w10_px( 220 ) : w10_rail_item(); }
+
+static void w10_fill( HDC hdc, int x, int y, int width, int height, COLORREF color )
+{
+    HGDIOBJ old_brush = SelectObject( hdc, GetStockObject( DC_BRUSH ));
+
+    SetDCBrushColor( hdc, color );
+    PatBlt( hdc, x, y, width, height, PATCOPY );
+    SelectObject( hdc, old_brush );
+}
+
+/* a menu string without its accelerator prefix */
+static void w10_load_string( UINT id, WCHAR *str, int size )
+{
+    WCHAR *src, *dst;
+
+    if (!LoadStringW( NULL, id, str, size )) str[0] = 0;
+    for (src = dst = str; *src; src++) if (*src != '&') *dst++ = *src;
+    *dst = 0;
+}
+
+static int __cdecl w10_compare_nodes( const void *a, const void *b )
+{
+    return lstrcmpiW( ((const struct w10_node *)a)->name, ((const struct w10_node *)b)->name );
+}
+
+static struct w10_node *w10_add_child( struct w10_node *parent )
+{
+    struct w10_node *children = realloc( parent->children, (parent->child_count + 1) * sizeof(*children) );
+
+    if (!children) return NULL;
+    parent->children = children;
+    memset( &children[parent->child_count], 0, sizeof(*children) );
+    return &children[parent->child_count++];
+}
+
+/* move the entries found by xp_add_dir_nodes under parent, only the files if files_only */
+static void w10_take_nodes( struct w10_node *parent, const struct xp_level *level, BOOL files_only )
+{
+    unsigned int i, j;
+
+    for (i = 0; i < level->count; i++)
+    {
+        const struct xp_node *src = &level->nodes[i];
+        struct w10_node *node;
+
+        if (files_only && src->folder) continue;
+        for (j = 0; j < parent->child_count; j++)
+            if (parent->children[j].folder == src->folder && !lstrcmpiW( parent->children[j].name, src->name )) break;
+        if (j < parent->child_count) continue;  /* in both places */
+        if (!(node = w10_add_child( parent ))) break;
+        lstrcpyW( node->name, src->name );
+        lstrcpyW( node->path, src->path );
+        lstrcpyW( node->path2, src->path2 );
+        node->folder = src->folder;
+    }
+    qsort( parent->children, parent->child_count, sizeof(*parent->children), w10_compare_nodes );
+}
+
+static void w10_scan( struct w10_node *parent, const WCHAR *dir, const WCHAR *dir2, BOOL files_only )
+{
+    struct xp_level level;
+    unsigned int capacity = 0;
+
+    memset( &level, 0, sizeof(level) );
+    if (dir && dir[0]) xp_add_dir_nodes( &level, &capacity, dir );
+    if (dir2 && dir2[0]) xp_add_dir_nodes( &level, &capacity, dir2 );
+    w10_take_nodes( parent, &level, files_only );
+    free( level.nodes );
+}
+
+static void w10_add_program( struct w10_node *parent, UINT string_id, const WCHAR *name )
+{
+    WCHAR path[MAX_PATH];
+    struct w10_node *node;
+
+    if (!SearchPathW( NULL, name, NULL, MAX_PATH, path, NULL )) return;
+    if (!(node = w10_add_child( parent ))) return;
+    w10_load_string( string_id, node->name, ARRAY_SIZE(node->name) );
+    lstrcpyW( node->path, path );
+}
+
+/* Wine's own tools, like the Windows System folder of Windows 10 */
+static void w10_add_system_folder(void)
+{
+    struct w10_node *folder, *node;
+    HICON icon = NULL;
+
+    if (!(folder = w10_add_child( &w10_root ))) return;
+    w10_load_string( IDS_W10_WINE_SYSTEM, folder->name, ARRAY_SIZE(folder->name) );
+    folder->folder = folder->loaded = TRUE;
+    if (SearchPathW( NULL, L"wfm.exe", NULL, MAX_PATH, folder->path, NULL ))
+        w10_add_program( folder, IDS_XP_FILE_MANAGER, L"wfm.exe" );
+    else
+        w10_add_program( folder, IDS_XP_FILE_MANAGER, L"winefile.exe" );
+    folder->path[0] = 0;
+    w10_add_program( folder, IDS_XP_COMMAND_PROMPT, L"cmd.exe" );
+    w10_add_program( folder, IDS_XP_CONTROL_PANEL, L"control.exe" );
+    if ((node = w10_add_child( folder )))
+    {
+        w10_load_string( IDS_W10_RUN, node->name, ARRAY_SIZE(node->name) );
+        node->run = node->icon_loaded = TRUE;
+        ExtractIconExW( L"shell32.dll", -IDI_SHELL_RUN_ID, &icon, NULL, 1 );
+        node->icon = icon;
+    }
+    w10_add_program( folder, IDS_TASK_MANAGER, L"taskmgr.exe" );
+    w10_add_program( folder, IDS_XP_WINECFG, L"winecfg.exe" );
+    qsort( folder->children, folder->child_count, sizeof(*folder->children), w10_compare_nodes );
+}
+
+static void w10_build_tree(void)
+{
+    WCHAR dir[MAX_PATH], dir2[MAX_PATH];
+
+    memset( &w10_root, 0, sizeof(w10_root) );
+    w10_root.folder = w10_root.loaded = w10_root.expanded = TRUE;
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_PROGRAMS, NULL, SHGFP_TYPE_CURRENT, dir ))) dir[0] = 0;
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_COMMON_PROGRAMS, NULL, SHGFP_TYPE_CURRENT, dir2 ))) dir2[0] = 0;
+    w10_scan( &w10_root, dir, dir2, FALSE );
+    /* the shortcuts at the top of the start menus, without their Programs folders */
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_STARTMENU, NULL, SHGFP_TYPE_CURRENT, dir ))) dir[0] = 0;
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_COMMON_STARTMENU, NULL, SHGFP_TYPE_CURRENT, dir2 ))) dir2[0] = 0;
+    w10_scan( &w10_root, dir, dir2, TRUE );
+    w10_add_system_folder();
+    qsort( w10_root.children, w10_root.child_count, sizeof(*w10_root.children), w10_compare_nodes );
+}
+
+static void w10_free_node( struct w10_node *node )
+{
+    unsigned int i;
+
+    for (i = 0; i < node->child_count; i++) w10_free_node( &node->children[i] );
+    free( node->children );
+    node->children = NULL;
+    node->child_count = 0;
+    if (node->icon) DestroyIcon( node->icon );
+    node->icon = NULL;
+}
+
+static void w10_load_children( struct w10_node *node )
+{
+    if (node->loaded) return;
+    node->loaded = TRUE;
+    w10_scan( node, node->path, node->path2, FALSE );
+}
+
+static HICON w10_node_icon( struct w10_node *node )
+{
+    SHFILEINFOW info;
+
+    if (node->folder) return w10_folder_icon;
+    if (node->icon_loaded) return node->icon;
+    node->icon_loaded = TRUE;
+    if (!lstrcmpiW( PathFindExtensionW( node->path ), L".lnk" )) node->icon = get_shortcut_icon( node->path );
+    if (!node->icon && SHGetFileInfoW( node->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+        node->icon = info.hIcon;
+    return node->icon;
+}
+
+static WCHAR w10_letter( const WCHAR *name )
+{
+    WCHAR c = name[0];
+
+    if (!c || !IsCharAlphaW( c )) return '#';
+    return (WCHAR)(UINT_PTR)CharUpperW( (WCHAR *)(UINT_PTR)c );
+}
+
+static void w10_add_row( struct w10_node *node, WCHAR letter, int depth )
+{
+    struct w10_row *row;
+
+    if (w10_row_count == w10_row_capacity)
+    {
+        unsigned int capacity = max( 64, w10_row_capacity * 2 );
+        struct w10_row *rows = realloc( w10_rows, capacity * sizeof(*rows) );
+
+        if (!rows) return;
+        w10_rows = rows;
+        w10_row_capacity = capacity;
+    }
+    row = &w10_rows[w10_row_count++];
+    row->node = node;
+    row->letter = letter;
+    row->depth = depth;
+}
+
+static void w10_add_rows( struct w10_node *parent, int depth )
+{
+    WCHAR letter = 0;
+    unsigned int i;
+
+    for (i = 0; i < parent->child_count; i++)
+    {
+        struct w10_node *node = &parent->children[i];
+
+        if (!depth && w10_letter( node->name ) != letter)
+        {
+            letter = w10_letter( node->name );
+            w10_add_row( NULL, letter, 0 );
+        }
+        w10_add_row( node, 0, depth );
+        if (node->folder && node->expanded) w10_add_rows( node, depth + 1 );
+    }
+}
+
+static int w10_max_scroll(void)
+{
+    return max( 0, w10_content_height - w10_height );
+}
+
+static void w10_build_rows(void)
+{
+    unsigned int i;
+    int y = w10_px( 10 );  /* some room above the first heading */
+
+    w10_row_count = 0;
+    w10_add_rows( &w10_root, 0 );
+    for (i = 0; i < w10_row_count; i++)
+    {
+        w10_rows[i].top = y;
+        y += w10_row_height();
+    }
+    w10_content_height = y + w10_px( 4 );
+    w10_scroll = max( 0, min( w10_scroll, w10_max_scroll() ));
+}
+
+/* simple line glyphs of the rail */
+static void w10_draw_rail_glyph( HDC hdc, int item, int cx, int cy )
+{
+    int s = w10_px( 8 ), i;
+    HGDIOBJ old_pen, old_brush;
+    POINT pts[7];
+    HPEN pen;
+
+    pen = CreatePen( PS_SOLID, max( 1, w10_px( 1 )), W10_TEXT );
+    old_pen = SelectObject( hdc, pen );
+    old_brush = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    switch (item)
+    {
+    case W10_RAIL_MENU:
+        for (i = -1; i <= 1; i++)
+        {
+            MoveToEx( hdc, cx - s, cy + i * s * 3 / 5, NULL );
+            LineTo( hdc, cx + s + 1, cy + i * s * 3 / 5 );
+        }
+        break;
+    case W10_RAIL_USER:
+        Ellipse( hdc, cx - s / 2, cy - s, cx + s / 2 + 1, cy + 1 );
+        Arc( hdc, cx - s, cy + s / 4, cx + s + 1, cy + s * 9 / 4, cx + s, cy + s * 5 / 4, cx - s, cy + s * 5 / 4 );
+        break;
+    case W10_RAIL_DOCUMENTS:
+        pts[0].x = cx - s * 3 / 4; pts[0].y = cy - s;
+        pts[1].x = cx + s / 4;     pts[1].y = cy - s;
+        pts[2].x = cx + s * 3 / 4; pts[2].y = cy - s / 2;
+        pts[3].x = cx + s * 3 / 4; pts[3].y = cy + s;
+        pts[4].x = cx - s * 3 / 4; pts[4].y = cy + s;
+        pts[5] = pts[0];
+        Polyline( hdc, pts, 6 );
+        MoveToEx( hdc, cx + s / 4, cy - s, NULL );
+        LineTo( hdc, cx + s / 4, cy - s / 2 );
+        LineTo( hdc, cx + s * 3 / 4, cy - s / 2 );
+        break;
+    case W10_RAIL_PICTURES:
+        Rectangle( hdc, cx - s, cy - s * 3 / 4, cx + s + 1, cy + s * 3 / 4 + 1 );
+        pts[0].x = cx - s;         pts[0].y = cy + s / 2;
+        pts[1].x = cx - s / 3;     pts[1].y = cy - s / 6;
+        pts[2].x = cx + s / 6;     pts[2].y = cy + s / 4;
+        pts[3].x = cx + s / 2;     pts[3].y = cy;
+        pts[4].x = cx + s;         pts[4].y = cy + s / 2;
+        Polyline( hdc, pts, 5 );
+        Ellipse( hdc, cx + s / 3, cy - s / 2, cx + s * 2 / 3 + 1, cy - s / 6 + 1 );
+        break;
+    case W10_RAIL_SETTINGS:
+    {
+        /* a cog: eight square teeth around a ring, and the hole in the middle */
+        static const double teeth[4][2] = { { -15.0, 0.72 }, { -9.0, 1.0 }, { 9.0, 1.0 }, { 15.0, 0.72 } };
+        POINT gear[33];
+        int count = 0, k, j;
+
+        for (k = 0; k < 8; k++)
+        {
+            for (j = 0; j < 4; j++)
+            {
+                double a = (k * 45.0 + teeth[j][0]) * 3.14159265358979 / 180.0, r = teeth[j][1] * s;
+
+                gear[count].x = cx + (LONG)floor( r * sin( a ) + 0.5 );
+                gear[count].y = cy - (LONG)floor( r * cos( a ) + 0.5 );
+                count++;
+            }
+        }
+        gear[count++] = gear[0];
+        Polyline( hdc, gear, count );
+        Ellipse( hdc, cx - s * 3 / 10, cy - s * 3 / 10, cx + s * 3 / 10 + 1, cy + s * 3 / 10 + 1 );
+        break;
+    }
+    case W10_RAIL_POWER:
+        /* counterclockwise from the top left to the top right leaves the gap at the top */
+        Arc( hdc, cx - s * 3 / 4, cy - s * 3 / 4 + 1, cx + s * 3 / 4 + 1, cy + s * 3 / 4 + 2,
+             cx - s / 3, cy - s, cx + s / 3, cy - s );
+        MoveToEx( hdc, cx, cy - s, NULL );
+        LineTo( hdc, cx, cy + 1 );
+        break;
+    }
+    SelectObject( hdc, old_brush );
+    SelectObject( hdc, old_pen );
+    DeleteObject( pen );
+}
+
+static void w10_rail_rect( int item, RECT *rect )
+{
+    int size = w10_rail_item();
+
+    rect->left = 0;
+    rect->right = w10_rail_width();
+    if (item == W10_RAIL_MENU) rect->top = 0;
+    else rect->top = w10_height - (W10_RAIL_COUNT - item) * size;
+    rect->bottom = rect->top + size;
+}
+
+static void w10_rail_label( int item, WCHAR *str, int size )
+{
+    static const UINT ids[W10_RAIL_COUNT] = { IDS_W10_START, 0, IDS_W10_DOCUMENTS, IDS_W10_PICTURES,
+                                              IDS_W10_SETTINGS, IDS_W10_POWER };
+
+    if (item == W10_RAIL_USER) lstrcpynW( str, w10_user, size );
+    else w10_load_string( ids[item], str, size );
+}
+
+static void w10_add_tile( const WCHAR *name, const WCHAR *path )
+{
+    struct w10_tile *tile;
+    SHFILEINFOW info;
+
+    if (w10_tile_count >= W10_MAX_TILES) return;
+    tile = &w10_tiles[w10_tile_count++];
+    memset( tile, 0, sizeof(*tile) );
+    lstrcpynW( tile->name, name, ARRAY_SIZE(tile->name) );
+    lstrcpynW( tile->path, path, ARRAY_SIZE(tile->path) );
+    if (!lstrcmpiW( PathFindExtensionW( path ), L".lnk" )) tile->icon = get_shortcut_icon( path );
+    if (!tile->icon && SHGetFileInfoW( path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+        tile->icon = info.hIcon;
+}
+
+static void w10_add_tool_tile( UINT string_id, const WCHAR *exe )
+{
+    WCHAR path[MAX_PATH], name[MAX_PATH];
+
+    if (!SearchPathW( NULL, exe, NULL, MAX_PATH, path, NULL )) return;
+    w10_load_string( string_id, name, ARRAY_SIZE(name) );
+    w10_add_tile( name, path );
+}
+
+/* the shortcuts of one desktop folder */
+static void w10_add_desktop_tiles( int csidl )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], path[MAX_PATH], name[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    unsigned int i;
+    HANDLE handle;
+
+    if (FAILED(SHGetFolderPathW( NULL, csidl, NULL, SHGFP_TYPE_CURRENT, dir ))) return;
+    if (!xp_join_path( pattern, dir, L"*.lnk" )) return;
+    if ((handle = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        if (!xp_join_path( path, dir, data.cFileName )) continue;
+        lstrcpynW( name, data.cFileName, ARRAY_SIZE(name) );
+        PathRemoveExtensionW( name );
+        for (i = 0; i < w10_tile_count; i++) if (!lstrcmpiW( w10_tiles[i].name, name )) break;
+        if (i == w10_tile_count) w10_add_tile( name, path );
+    } while (w10_tile_count < W10_MAX_TILES && FindNextFileW( handle, &data ));
+    FindClose( handle );
+}
+
+static unsigned int w10_tile_split;  /* the first desktop tile, after the Wine tools */
+
+static void w10_build_tiles(void)
+{
+    w10_tile_count = 0;
+    if (SearchPathW( NULL, L"wfm.exe", NULL, 0, NULL, NULL )) w10_add_tool_tile( IDS_XP_FILE_MANAGER, L"wfm.exe" );
+    else w10_add_tool_tile( IDS_XP_FILE_MANAGER, L"winefile.exe" );
+    w10_add_tool_tile( IDS_XP_CONTROL_PANEL, L"control.exe" );
+    /* control.exe has no icon of its own: the Control Panel one, as in the XP style menu */
+    if (w10_tile_count && !lstrcmpiW( PathFindFileNameW( w10_tiles[w10_tile_count - 1].path ), L"control.exe" ))
+    {
+        HICON icon = NULL;
+
+        if (ExtractIconExW( L"shell32.dll", -IDI_SHELL_CONTROL_PANEL_ID, &icon, NULL, 1 ) && icon)
+        {
+            if (w10_tiles[w10_tile_count - 1].icon) DestroyIcon( w10_tiles[w10_tile_count - 1].icon );
+            w10_tiles[w10_tile_count - 1].icon = icon;
+        }
+    }
+    w10_add_tool_tile( IDS_XP_WINECFG, L"winecfg.exe" );
+    w10_add_tool_tile( IDS_XP_COMMAND_PROMPT, L"cmd.exe" );
+    w10_add_tool_tile( IDS_TASK_MANAGER, L"taskmgr.exe" );
+    w10_tile_split = w10_tile_count;
+    w10_add_desktop_tiles( CSIDL_DESKTOPDIRECTORY );
+    w10_add_desktop_tiles( CSIDL_COMMON_DESKTOPDIRECTORY );
+}
+
+/* two groups of square tiles, three per row; what does not fit is left out */
+static void w10_layout_tiles(void)
+{
+    int size = w10_px( 96 ), gap = w10_px( 4 ), left = w10_list_right + w10_px( 8 ), y = w10_px( 6 );
+    int label = w10_px( 30 ), bottom = w10_height - w10_px( 8 );
+    unsigned int group, i, start, end;
+
+    for (group = 0; group < 2; group++)
+    {
+        start = group ? w10_tile_split : 0;
+        end = group ? w10_tile_count : w10_tile_split;
+        SetRectEmpty( &w10_group_rects[group] );
+        for (i = start; i < end; i++) SetRectEmpty( &w10_tiles[i].rect );
+        if (start >= end || y + label + size > bottom) continue;
+        SetRect( &w10_group_rects[group], left, y, left + 3 * size + 2 * gap, y + label );
+        y += label;
+        for (i = start; i < end; i++)
+        {
+            int col = (i - start) % 3, row = (i - start) / 3;
+            RECT *rect = &w10_tiles[i].rect;
+
+            SetRect( rect, left + col * (size + gap), y + row * (size + gap),
+                     left + col * (size + gap) + size, y + row * (size + gap) + size );
+            if (rect->bottom > bottom) SetRectEmpty( rect );
+        }
+        y += (int)((end - start + 2) / 3) * (size + gap) + w10_px( 8 );
+    }
+}
+
+static void w10_paint_tiles( HDC hdc )
+{
+    COLORREF accent = get_accent_color(), hot = xp_blend( accent, RGB(0xff,0xff,0xff), 1, 2 );
+    int icon = w10_px( 36 ), edge = max( 1, w10_px( 2 ));
+    WCHAR str[64];
+    unsigned int i;
+    HGDIOBJ old_font;
+    RECT rect;
+
+    for (i = 0; i < 2; i++)
+    {
+        if (IsRectEmpty( &w10_group_rects[i] )) continue;
+        w10_load_string( i ? IDS_W10_TILES_DESKTOP : IDS_W10_TILES_WINE, str, ARRAY_SIZE(str) );
+        rect = w10_group_rects[i];
+        DrawTextW( hdc, str, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX );
+    }
+    old_font = SelectObject( hdc, w10_small_font );
+    for (i = 0; i < w10_tile_count; i++)
+    {
+        const struct w10_tile *tile = &w10_tiles[i];
+        const RECT *r = &tile->rect;
+
+        if (IsRectEmpty( r )) continue;
+        w10_fill( hdc, r->left, r->top, r->right - r->left, r->bottom - r->top, accent );
+        if (tile->icon)
+            DrawIconEx( hdc, (r->left + r->right - icon) / 2, r->top + (r->bottom - r->top - icon) / 2 - w10_px( 8 ),
+                        tile->icon, icon, icon, 0, NULL, DI_NORMAL );
+        SetRect( &rect, r->left + w10_px( 6 ), r->bottom - w10_px( 24 ), r->right - w10_px( 4 ), r->bottom - w10_px( 4 ));
+        DrawTextW( hdc, tile->name, -1, &rect, DT_SINGLELINE | DT_BOTTOM | DT_LEFT | DT_NOPREFIX | DT_END_ELLIPSIS );
+        if ((int)i == w10_hot_tile)
+        {
+            w10_fill( hdc, r->left, r->top, r->right - r->left, edge, hot );
+            w10_fill( hdc, r->left, r->bottom - edge, r->right - r->left, edge, hot );
+            w10_fill( hdc, r->left, r->top, edge, r->bottom - r->top, hot );
+            w10_fill( hdc, r->right - edge, r->top, edge, r->bottom - r->top, hot );
+        }
+    }
+    SelectObject( hdc, old_font );
+}
+
+static void w10_free_tiles(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < w10_tile_count; i++) if (w10_tiles[i].icon) DestroyIcon( w10_tiles[i].icon );
+    w10_tile_count = 0;
+}
+
+static void w10_paint( HWND hwnd )
+{
+    int rail = w10_rail_width(), list_left = w10_rail_item(), row_h = w10_row_height(), icon = w10_px( 24 );
+    HGDIOBJ old_bitmap, old_font;
+    HBITMAP bitmap;
+    PAINTSTRUCT ps;
+    unsigned int i;
+    WCHAR str[MAX_PATH];
+    RECT rect;
+    HDC hdc, mem;
+    int item;
+
+    hdc = BeginPaint( hwnd, &ps );
+    if (!(mem = CreateCompatibleDC( hdc )))
+    {
+        EndPaint( hwnd, &ps );
+        return;
+    }
+    bitmap = CreateCompatibleBitmap( hdc, w10_width, w10_height );
+    old_bitmap = SelectObject( mem, bitmap );
+    old_font = SelectObject( mem, w10_font );
+    SetBkMode( mem, TRANSPARENT );
+    SetTextColor( mem, W10_TEXT );
+    w10_fill( mem, 0, 0, w10_width, w10_height, W10_BACK );
+
+    /* the list */
+    IntersectClipRect( mem, list_left, 0, w10_list_right, w10_height );
+    for (i = 0; i < w10_row_count; i++)
+    {
+        const struct w10_row *row = &w10_rows[i];
+        int y = row->top - w10_scroll, x = list_left + w10_px( 12 ) + row->depth * w10_px( 16 );
+
+        if (y + row_h <= 0 || y >= w10_height) continue;
+        if ((int)i == w10_hot_row) w10_fill( mem, list_left, y, w10_list_right - list_left, row_h, W10_HOT_BACK );
+        if (!row->node)
+        {
+            str[0] = row->letter;
+            str[1] = 0;
+            SetRect( &rect, list_left + w10_px( 14 ), y, w10_list_right, y + row_h );
+            DrawTextW( mem, str, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX );
+            continue;
+        }
+        if (w10_node_icon( row->node ))
+            DrawIconEx( mem, x, y + (row_h - icon) / 2, w10_node_icon( row->node ), icon, icon, 0, NULL, DI_NORMAL );
+        SetRect( &rect, x + icon + w10_px( 12 ), y, w10_list_right - w10_px( row->node->folder ? 32 : 10 ), y + row_h );
+        DrawTextW( mem, row->node->name, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX | DT_END_ELLIPSIS );
+        if (row->node->folder)
+        {
+            /* a chevron, pointing up while the folder is open */
+            int cx = w10_list_right - w10_px( 20 ), cy = y + row_h / 2, s = w10_px( 4 ), dir = row->node->expanded ? -1 : 1;
+            HPEN pen = CreatePen( PS_SOLID, max( 1, w10_px( 1 )), W10_TEXT );
+            HGDIOBJ old_pen = SelectObject( mem, pen );
+
+            MoveToEx( mem, cx - s, cy - dir * s / 2, NULL );
+            LineTo( mem, cx, cy + dir * s / 2 );
+            LineTo( mem, cx + s + 1, cy - dir * s / 2 - dir );
+            SelectObject( mem, old_pen );
+            DeleteObject( pen );
+        }
+    }
+    if (w10_content_height > w10_height && (w10_list_hover || w10_dragging))
+    {
+        int thumb = max( w10_px( 24 ), w10_height * w10_height / w10_content_height );
+        int pos = MulDiv( w10_scroll, w10_height - thumb, max( 1, w10_max_scroll() ));
+
+        w10_fill( mem, w10_list_right - w10_px( 3 ), pos, max( 1, w10_px( 2 )), thumb, W10_SCROLL );
+    }
+    SelectClipRgn( mem, NULL );
+    w10_paint_tiles( mem );
+
+    /* the rail, over the list while it shows the names */
+    if (w10_rail_wide)
+    {
+        w10_fill( mem, 0, 0, rail, w10_height, W10_RAIL_BACK );
+        w10_fill( mem, rail, 0, 1, w10_height, RGB(0x10,0x10,0x10) );
+    }
+    for (item = 0; item < W10_RAIL_COUNT; item++)
+    {
+        int size = w10_rail_item();
+
+        w10_rail_rect( item, &rect );
+        if (item == w10_hot_rail) w10_fill( mem, rect.left, rect.top, rect.right - rect.left, size, W10_HOT_BACK );
+        w10_draw_rail_glyph( mem, item, size / 2, rect.top + size / 2 );
+        if (w10_rail_wide)
+        {
+            w10_rail_label( item, str, ARRAY_SIZE(str) );
+            rect.left = size;
+            DrawTextW( mem, str, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX | DT_END_ELLIPSIS );
+        }
+    }
+
+    BitBlt( hdc, 0, 0, w10_width, w10_height, mem, 0, 0, SRCCOPY );
+    SelectObject( mem, old_font );
+    SelectObject( mem, old_bitmap );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+    EndPaint( hwnd, &ps );
+}
+
+static void w10_hit_test( POINT pt, int *rail, int *row, int *tile )
+{
+    unsigned int i;
+    int item, y;
+    RECT rect;
+
+    *rail = *row = *tile = -1;
+    if (pt.x < 0 || pt.y < 0 || pt.x >= w10_width || pt.y >= w10_height) return;
+    if (pt.x >= w10_list_right)
+    {
+        for (i = 0; i < w10_tile_count; i++) if (PtInRect( &w10_tiles[i].rect, pt )) *tile = i;
+        return;
+    }
+    if (pt.x < w10_rail_width())
+    {
+        for (item = 0; item < W10_RAIL_COUNT; item++)
+        {
+            w10_rail_rect( item, &rect );
+            if (PtInRect( &rect, pt )) *rail = item;
+        }
+        return;
+    }
+    y = pt.y + w10_scroll;
+    for (i = 0; i < w10_row_count; i++)
+    {
+        if (y < w10_rows[i].top || y >= w10_rows[i].top + w10_row_height()) continue;
+        if (w10_rows[i].node) *row = i;
+        break;
+    }
+}
+
+static void w10_set_hot( int rail, int row, int tile )
+{
+    if (rail == w10_hot_rail && row == w10_hot_row && tile == w10_hot_tile) return;
+    w10_hot_rail = rail;
+    w10_hot_row = row;
+    w10_hot_tile = tile;
+    InvalidateRect( w10_window, NULL, FALSE );
+}
+
+static void w10_ensure_visible( int index )
+{
+    int top = w10_rows[index].top, bottom = top + w10_row_height();
+
+    if (top < w10_scroll) w10_scroll = top;
+    else if (bottom > w10_scroll + w10_height) w10_scroll = bottom - w10_height;
+    w10_scroll = max( 0, min( w10_scroll, w10_max_scroll() ));
+}
+
+static void w10_move_hot( int dir )
+{
+    int index = w10_hot_row, count = w10_row_count;
+
+    do index += dir; while (index >= 0 && index < count && !w10_rows[index].node);
+    if (index < 0 || index >= count) return;
+    w10_ensure_visible( index );
+    w10_hot_rail = -1;
+    w10_hot_row = index;
+    InvalidateRect( w10_window, NULL, FALSE );
+}
+
+static void w10_click_row( int index )
+{
+    struct w10_node *node;
+    unsigned int i;
+
+    if (index < 0 || index >= (int)w10_row_count || !(node = w10_rows[index].node)) return;
+    if (node->folder)
+    {
+        w10_load_children( node );
+        node->expanded = !node->expanded;
+        w10_build_rows();
+        for (i = 0; i < w10_row_count; i++) if (w10_rows[i].node == node) w10_hot_row = i;
+        InvalidateRect( w10_window, NULL, FALSE );
+        return;
+    }
+    if (node->run) w10_action = W10_RUN;
+    else
+    {
+        lstrcpynW( w10_action_path, node->path, ARRAY_SIZE(w10_action_path) );
+        w10_action = W10_LAUNCH;
+    }
+    w10_done = TRUE;
+}
+
+static WCHAR w10_power_text[64];
+static HBRUSH w10_power_brush;
+
+static void w10_measure_power_item( MEASUREITEMSTRUCT *mis )
+{
+    mis->itemWidth = w10_px( 220 );
+    mis->itemHeight = w10_px( 40 );
+}
+
+static void w10_draw_power_item( const DRAWITEMSTRUCT *dis )
+{
+    RECT rect = dis->rcItem;
+    int size = w10_rail_item();
+    HGDIOBJ old_font;
+
+    w10_fill( dis->hDC, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+              (dis->itemState & ODS_SELECTED) ? W10_HOT_BACK : W10_RAIL_BACK );
+    w10_draw_rail_glyph( dis->hDC, W10_RAIL_POWER, rect.left + size / 2, (rect.top + rect.bottom) / 2 );
+    old_font = SelectObject( dis->hDC, w10_font );
+    SetBkMode( dis->hDC, TRANSPARENT );
+    SetTextColor( dis->hDC, W10_TEXT );
+    rect.left += size;
+    DrawTextW( dis->hDC, w10_power_text, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_LEFT | DT_NOPREFIX );
+    SelectObject( dis->hDC, old_font );
+}
+
+static void w10_power_menu( HWND hwnd )
+{
+    WCHAR str[64];
+    HMENU menu;
+    RECT rect;
+    POINT pt;
+    int cmd;
+
+    if (!(menu = CreatePopupMenu())) return;
+    w10_load_string( IDS_W10_SHUT_DOWN, str, ARRAY_SIZE(str) );
+    lstrcpynW( w10_power_text, str, ARRAY_SIZE(w10_power_text) );
+    /* drawn by hand, as the flyout of Windows 10: dark, a power glyph, a tall row */
+    AppendMenuW( menu, MF_OWNERDRAW, 1, (const WCHAR *)w10_power_text );
+    {
+        MENUINFO info = { sizeof(info), MIM_BACKGROUND };
+
+        info.hbrBack = w10_power_brush ? w10_power_brush : (w10_power_brush = CreateSolidBrush( W10_RAIL_BACK ));
+        SetMenuInfo( menu, &info );
+    }
+    w10_rail_rect( W10_RAIL_POWER, &rect );
+    pt.x = rect.left + w10_rail_item() / 2;
+    pt.y = rect.top;
+    ClientToScreen( hwnd, &pt );
+    w10_in_popup = TRUE;
+    cmd = TrackPopupMenuEx( menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_BOTTOMALIGN, pt.x, pt.y, hwnd, NULL );
+    w10_in_popup = FALSE;
+    DestroyMenu( menu );
+    if (cmd == 1)
+    {
+        w10_action = W10_SHUT_DOWN;
+        w10_done = TRUE;
+    }
+    else SetCapture( hwnd );
+}
+
+static void w10_click_rail( HWND hwnd, int item )
+{
+    static const int csidls[W10_RAIL_COUNT] = { 0, CSIDL_PROFILE, CSIDL_PERSONAL, CSIDL_MYPICTURES, 0, 0 };
+
+    switch (item)
+    {
+    case W10_RAIL_MENU:
+        w10_rail_wide = !w10_rail_wide;
+        InvalidateRect( hwnd, NULL, FALSE );
+        break;
+    case W10_RAIL_USER:
+    case W10_RAIL_DOCUMENTS:
+    case W10_RAIL_PICTURES:
+        w10_action = W10_FOLDER;
+        w10_action_csidl = csidls[item];
+        w10_done = TRUE;
+        break;
+    case W10_RAIL_SETTINGS:
+        w10_action = W10_SETTINGS;
+        w10_done = TRUE;
+        break;
+    case W10_RAIL_POWER:
+        w10_power_menu( hwnd );
+        break;
+    }
+}
+
+static void w10_execute(void)
+{
+    SHELLEXECUTEINFOW sei;
+    LPITEMIDLIST pidl;
+
+    switch (w10_action)
+    {
+    case W10_LAUNCH:
+        ShellExecuteW( NULL, NULL, w10_action_path, NULL, NULL, SW_SHOWNORMAL );
+        break;
+    case W10_FOLDER:
+        if (FAILED(SHGetSpecialFolderLocation( NULL, w10_action_csidl, &pidl ))) break;
+        memset( &sei, 0, sizeof(sei) );
+        sei.cbSize = sizeof(sei);
+        sei.fMask = SEE_MASK_IDLIST;
+        sei.nShow = SW_SHOWNORMAL;
+        sei.lpIDList = pidl;
+        ShellExecuteExW( &sei );
+        CoTaskMemFree( pidl );
+        break;
+    case W10_RUN:
+        run_dialog();
+        break;
+    case W10_SHUT_DOWN:
+        shut_down( w10_tray );
+        break;
+    case W10_SETTINGS:
+        show_theme_settings();
+        break;
+    default:
+        break;
+    }
+}
+
+static LRESULT CALLBACK w10_menu_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    int rail, row, tile;
+    BOOL hover;
+    POINT pt;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        w10_paint( hwnd );
+        return 0;
+
+    case WM_MEASUREITEM:
+        if (((MEASUREITEMSTRUCT *)lparam)->CtlType != ODT_MENU) break;
+        w10_measure_power_item( (MEASUREITEMSTRUCT *)lparam );
+        return TRUE;
+
+    case WM_DRAWITEM:
+        if (((DRAWITEMSTRUCT *)lparam)->CtlType != ODT_MENU) break;
+        w10_draw_power_item( (const DRAWITEMSTRUCT *)lparam );
+        return TRUE;
+
+    case WM_ERASEBKGND:
+        return 1;
+
+    case WM_MOUSEMOVE:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        hover = pt.x >= w10_rail_item() && pt.x < w10_list_right && pt.y >= 0 && pt.y < w10_height;
+        if (hover != w10_list_hover)
+        {
+            w10_list_hover = hover;
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        if (w10_button_down && !w10_dragging && w10_down_pt.x >= w10_rail_width() &&
+            w10_down_pt.x < w10_list_right && abs( pt.y - w10_down_pt.y ) > w10_px( 8 ))
+            w10_dragging = TRUE;  /* a drag scrolls the list, as with touch on Windows */
+        if (w10_dragging)
+        {
+            w10_scroll = max( 0, min( w10_down_scroll - (pt.y - w10_down_pt.y), w10_max_scroll() ));
+            w10_set_hot( -1, -1, -1 );
+            InvalidateRect( hwnd, NULL, FALSE );
+            return 0;
+        }
+        w10_hit_test( pt, &rail, &row, &tile );
+        w10_set_hot( rail, row, tile );
+        return 0;
+
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+    case WM_MBUTTONDOWN:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        if (pt.x < 0 || pt.y < 0 || pt.x >= w10_width || pt.y >= w10_height)
+        {
+            w10_done = TRUE;  /* clicked outside of the menu */
+            return 0;
+        }
+        if (msg != WM_LBUTTONDOWN) return 0;
+        w10_button_down = TRUE;
+        w10_dragging = FALSE;
+        w10_down_pt = pt;
+        w10_down_scroll = w10_scroll;
+        return 0;
+
+    case WM_LBUTTONUP:
+        if (!w10_button_down) return 0;
+        w10_button_down = FALSE;
+        if (w10_dragging)
+        {
+            w10_dragging = FALSE;
+            return 0;
+        }
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        w10_hit_test( pt, &rail, &row, &tile );
+        w10_set_hot( rail, row, tile );
+        if (rail >= 0) w10_click_rail( hwnd, rail );
+        else if (tile >= 0)
+        {
+            lstrcpynW( w10_action_path, w10_tiles[tile].path, ARRAY_SIZE(w10_action_path) );
+            w10_action = W10_LAUNCH;
+            w10_done = TRUE;
+        }
+        else if (w10_rail_wide)
+        {
+            w10_rail_wide = FALSE;
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        else if (row >= 0) w10_click_row( row );
+        return 0;
+
+    case WM_MOUSEWHEEL:
+        w10_scroll -= MulDiv( GET_WHEEL_DELTA_WPARAM( wparam ), 3 * w10_row_height(), WHEEL_DELTA );
+        w10_scroll = max( 0, min( w10_scroll, w10_max_scroll() ));
+        w10_set_hot( -1, -1, -1 );
+        w10_list_hover = TRUE;
+        InvalidateRect( hwnd, NULL, FALSE );
+        return 0;
+
+    case WM_KEYDOWN:
+        switch (wparam)
+        {
+        case VK_ESCAPE:
+            if (w10_rail_wide)
+            {
+                w10_rail_wide = FALSE;
+                InvalidateRect( hwnd, NULL, FALSE );
+            }
+            else w10_done = TRUE;
+            break;
+        case VK_UP:
+        case VK_DOWN:
+            w10_move_hot( wparam == VK_DOWN ? 1 : -1 );
+            break;
+        case VK_RETURN:
+            if (w10_hot_rail >= 0) w10_click_rail( hwnd, w10_hot_rail );
+            else w10_click_row( w10_hot_row );
+            break;
+        }
+        return 0;
+
+    case WM_ACTIVATE:
+        if (LOWORD( wparam ) == WA_INACTIVE && !w10_in_popup) w10_done = TRUE;
+        break;
+
+    case WM_CAPTURECHANGED:
+        if ((HWND)lparam != hwnd && !w10_in_popup) w10_done = TRUE;
+        break;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+void do_win10_startmenu( HWND tray )
+{
+    static const WCHAR classW[] = L"__wine_win10_start_menu";
+    static BOOL registered;
+    WCHAR sysdir[MAX_PATH];
+    SHFILEINFOW info;
+    RECT tray_rect;
+    LOGFONTW lf;
+    DWORD size;
+    MSG msg;
+
+    if (w10_window) return;
+    if (!registered)
+    {
+        WNDCLASSEXW cls;
+
+        memset( &cls, 0, sizeof(cls) );
+        cls.cbSize = sizeof(cls);
+        cls.lpfnWndProc = w10_menu_proc;
+        cls.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+        cls.lpszClassName = classW;
+        registered = RegisterClassExW( &cls ) != 0;
+    }
+
+    w10_tray = tray;
+    w10_dpi = GetDpiForWindow( tray );
+    if (!w10_dpi) w10_dpi = USER_DEFAULT_SCREEN_DPI;
+    memset( &lf, 0, sizeof(lf) );
+    lf.lfHeight = -w10_px( 13 );
+    lf.lfWeight = FW_NORMAL;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lstrcpyW( lf.lfFaceName, L"Tahoma" );
+    w10_font = CreateFontIndirectW( &lf );
+    lf.lfHeight = -w10_px( 11 );
+    w10_small_font = CreateFontIndirectW( &lf );
+    size = ARRAY_SIZE(w10_user);
+    if (!GetUserNameW( w10_user, &size )) lstrcpyW( w10_user, L"User" );
+    GetSystemDirectoryW( sysdir, ARRAY_SIZE(sysdir) );
+    w10_folder_icon = SHGetFileInfoW( sysdir, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ) ? info.hIcon : NULL;
+
+    GetWindowRect( tray, &tray_rect );
+    /* about two thirds of the screen high, as Windows 10 opens it */
+    w10_height = min( max( tray_rect.top, w10_px( 200 )), max( w10_px( 360 ), GetSystemMetrics( SM_CYSCREEN ) * 2 / 3 ));
+    w10_list_right = w10_px( 48 + 272 );
+    w10_build_tiles();
+    w10_width = w10_tile_count ? w10_list_right + w10_px( 8 + 3 * 96 + 2 * 4 + 12 ) : w10_list_right;
+    w10_layout_tiles();
+    w10_scroll = 0;
+    w10_hot_row = w10_hot_rail = w10_hot_tile = -1;
+    w10_rail_wide = w10_done = w10_in_popup = w10_button_down = w10_dragging = w10_list_hover = FALSE;
+    w10_action = W10_NONE;
+    w10_build_tree();
+    w10_build_rows();
+
+    w10_window = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, classW, NULL, WS_POPUP,
+                                  tray_rect.left, max( 0, tray_rect.top - w10_height ), w10_width, w10_height,
+                                  tray, 0, 0, 0 );
+    if (w10_window)
+    {
+        ShowWindow( w10_window, SW_SHOWNORMAL );
+        SetForegroundWindow( w10_window );
+        SetFocus( w10_window );
+        SetCapture( w10_window );
+        UpdateWindow( w10_window );
+
+        while (!w10_done)
+        {
+            if (!GetMessageW( &msg, 0, 0, 0 ))
+            {
+                PostQuitMessage( msg.wParam );
+                break;
+            }
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+
+        w10_in_popup = TRUE;
+        if (GetCapture() == w10_window) ReleaseCapture();
+        DestroyWindow( w10_window );
+        w10_window = 0;
+        w10_in_popup = FALSE;
+        /* launch after the menu is gone so that the program can take the foreground */
+        w10_execute();
+    }
+
+    w10_free_node( &w10_root );
+    w10_free_tiles();
+    free( w10_rows );
+    w10_rows = NULL;
+    w10_row_count = w10_row_capacity = 0;
+    if (w10_folder_icon) DestroyIcon( w10_folder_icon );
+    w10_folder_icon = NULL;
+    if (w10_font) DeleteObject( w10_font );
+    if (w10_small_font) DeleteObject( w10_small_font );
+    w10_font = w10_small_font = 0;
+}
