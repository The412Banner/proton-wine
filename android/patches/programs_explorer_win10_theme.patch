+static void win10_get_search_rect( RECT *rect )
+{
+    SetRect( rect, start_button_width, 0, 2 * start_button_width, row_height );
+}
+
+static void win10_get_desktop_rect( RECT *rect )
+{
+    SetRect( rect, tray_width - xp_scale( 6 ), 0, tray_width, tray_height );
+}
+
+/* a magnifier, the search button opens the Run dialog */
+static void win10_draw_search( HDC hdc )
+{
+    int d = xp_scale( 14 ), r = d * 3 / 8, cx, cy, ccx, ccy;
+    HGDIOBJ old_pen, old_brush;
+    HPEN pen;
+    RECT rect;
+
+    win10_get_search_rect( &rect );
+    fill_solid( hdc, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+                win10_part_color( win10_pressed == WIN10_SEARCH, win10_hot_part == WIN10_SEARCH ));
+    cx = (rect.left + rect.right) / 2;
+    cy = (rect.top + rect.bottom) / 2;
+    ccx = cx + d / 8;
+    ccy = cy - d / 8;
+    pen = CreatePen( PS_SOLID, max( 1, xp_scale( 1 )), RGB(0xff,0xff,0xff) );
+    old_pen = SelectObject( hdc, pen );
+    old_brush = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    Ellipse( hdc, ccx - r, ccy - r, ccx + r + 1, ccy + r + 1 );
+    MoveToEx( hdc, ccx - r * 7 / 10, ccy + r * 7 / 10, NULL );
+    LineTo( hdc, cx - d / 2, cy + d / 2 );
+    SelectObject( hdc, old_brush );
+    SelectObject( hdc, old_pen );
+    DeleteObject( pen );
+}
+
+/* the thin Show desktop strip at the right end, with a line on its left */
+static void win10_draw_desktop_edge( HDC hdc )
+{
+    RECT rect;
+
+    win10_get_desktop_rect( &rect );
+    fill_solid( hdc, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+                win10_part_color( win10_pressed == WIN10_DESKTOP, win10_hot_part == WIN10_DESKTOP ));
+    fill_solid( hdc, rect.left, rect.top, 1, rect.bottom - rect.top, RGB(0x5a,0x5a,0x5a) );
+}
