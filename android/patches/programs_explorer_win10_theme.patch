+/* the accent button of Display Properties: a swatch of the color */
+static void draw_accent_button( const DRAWITEMSTRUCT *dis, COLORREF accent )
+{
+    RECT rect = dis->rcItem;
+    HBRUSH brush;
+
+    DrawFrameControl( dis->hDC, &rect, DFC_BUTTON, DFCS_BUTTONPUSH | ((dis->itemState & ODS_SELECTED) ? DFCS_PUSHED : 0) );
+    InflateRect( &rect, -4, -4 );
+    if ((brush = CreateSolidBrush( (dis->itemState & ODS_DISABLED) ? GetSysColor( COLOR_BTNSHADOW ) : accent )))
+    {
+        FillRect( dis->hDC, &rect, brush );
+        DeleteObject( brush );
+    }
+    FrameRect( dis->hDC, &rect, GetSysColorBrush( COLOR_WINDOWFRAME ));
+    if (dis->itemState & ODS_FOCUS)
+    {
+        InflateRect( &rect, 2, 2 );
+        DrawFocusRect( dis->hDC, &rect );
+    }
+}
+
+#define ACCENT_COLUMNS 8
+
+static BOOL get_accent_cell( HWND grid, int index, RECT *rect )
+{
+    RECT client;
+    int cw, ch;
+
+    GetClientRect( grid, &client );
+    cw = client.right / ACCENT_COLUMNS;
+    ch = client.bottom / (ARRAY_SIZE(win10_palette) / ACCENT_COLUMNS);
+    if (index < 0 || index >= (int)ARRAY_SIZE(win10_palette) || cw <= 0 || ch <= 0) return FALSE;
+    SetRect( rect, (index % ACCENT_COLUMNS) * cw, (index / ACCENT_COLUMNS) * ch,
+             (index % ACCENT_COLUMNS + 1) * cw, (index / ACCENT_COLUMNS + 1) * ch );
+    return TRUE;
+}
+
+static void draw_accent_grid( const DRAWITEMSTRUCT *dis, COLORREF selected )
+{
+    int i, edge = max( 2, xp_scale( 2 ));
+    HBRUSH brush;
+    RECT rect;
+
+    FillRect( dis->hDC, &dis->rcItem, GetSysColorBrush( COLOR_BTNFACE ));
+    for (i = 0; i < (int)ARRAY_SIZE(win10_palette); i++)
+    {
+        if (!get_accent_cell( dis->hwndItem, i, &rect )) continue;
+        if (win10_palette[i] == selected)
+        {
+            if ((brush = CreateSolidBrush( GetSysColor( COLOR_WINDOWTEXT ))))
+            {
+                FillRect( dis->hDC, &rect, brush );
+                DeleteObject( brush );
+            }
+        }
+        InflateRect( &rect, -edge, -edge );
+        if ((brush = CreateSolidBrush( win10_palette[i] )))
+        {
+            FillRect( dis->hDC, &rect, brush );
+            DeleteObject( brush );
+        }
+    }
+}
+
+/* a grid of swatches; lparam points to the color, which is changed on OK */
+static INT_PTR CALLBACK accent_colors_proc( HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    static COLORREF *result, selected;
+    HWND grid = GetDlgItem( dlg, IDC_AC_GRID );
+    POINT pt;
+    RECT rect;
+    int i;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        result = (COLORREF *)lparam;
+        selected = *result;
+        return TRUE;
+
+    case WM_DRAWITEM:
+        if (wparam != IDC_AC_GRID) break;
+        draw_accent_grid( (const DRAWITEMSTRUCT *)lparam, selected );
+        return TRUE;
+
+    case WM_LBUTTONDOWN:
+    case WM_LBUTTONDBLCLK:
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        MapWindowPoints( dlg, grid, &pt, 1 );
+        for (i = 0; get_accent_cell( grid, i, &rect ); i++)
+        {
+            if (!PtInRect( &rect, pt )) continue;
+            selected = win10_palette[i];
+            InvalidateRect( grid, NULL, FALSE );
+            if (msg == WM_LBUTTONDBLCLK)
+            {
+                *result = selected;
+                EndDialog( dlg, IDOK );
+            }
+            break;
+        }
+        return TRUE;
+
+    case WM_COMMAND:
+        if (LOWORD( wparam ) == IDOK) *result = selected;
+        if (LOWORD( wparam ) == IDOK || LOWORD( wparam ) == IDCANCEL) EndDialog( dlg, LOWORD( wparam ));
+        return TRUE;
+    }
+    return FALSE;
+}
