+/* the Run dialog, for the search button of the Windows 10 style taskbar */
+/* Windows 10 opens Run at the bottom left, just above the start button: move shell32's dialog
+ * there as it is activated the first time */
+static HHOOK run_hook;
+
+static LRESULT CALLBACK run_dialog_hook( int code, WPARAM wparam, LPARAM lparam )
+{
+    if (code == HCBT_ACTIVATE)
+    {
+        HWND hwnd = (HWND)wparam;
+        WCHAR name[16];
+        RECT work, rect;
+
+        if (GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) && !lstrcmpW( name, L"#32770" ) &&
+            SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 ) && GetWindowRect( hwnd, &rect ))
+        {
+            int margin = MulDiv( 12, GetDpiForWindow( hwnd ), 96 );
+            HWND tray = FindWindowW( L"Shell_TrayWnd", NULL );
+            RECT bar;
+
+            /* the work area does not always leave the taskbar out */
+            if (tray && GetWindowRect( tray, &bar ) && bar.top > work.top && bar.top < work.bottom)
+                work.bottom = bar.top;
+            UnhookWindowsHookEx( run_hook );
+            run_hook = NULL;
+            SetWindowPos( hwnd, 0, work.left + margin, work.bottom - (rect.bottom - rect.top) - margin, 0, 0,
+                          SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+            /* started from the taskbar, which never holds the foreground: take it */
+            SetForegroundWindow( hwnd );
+        }
+    }
+    return CallNextHookEx( NULL, code, wparam, lparam );
+}
+
+void do_run_dialog(void)
+{
+    run_hook = SetWindowsHookExW( WH_CBT, run_dialog_hook, NULL, GetCurrentThreadId() );
+    run_dialog();
+    if (run_hook) UnhookWindowsHookEx( run_hook );
+    run_hook = NULL;
+}
