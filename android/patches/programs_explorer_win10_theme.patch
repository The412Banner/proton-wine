+static HICON win10_get_task_icon( struct taskbar_button *win )
+{
+    HICON small_icon = xp_get_task_icon( win );
+
+    /* a console window: the command prompt's icon, as Windows shows it (the window itself
+     * belongs to conhost.exe, which has none) */
+    if (!win->console_checked)
+    {
+        WCHAR name[32], path[MAX_PATH];
+
+        win->console_checked = TRUE;
+        if (GetClassNameW( win->hwnd, name, ARRAY_SIZE(name) ) && !lstrcmpW( name, L"WineConsoleClass" ) &&
+            GetSystemDirectoryW( path, MAX_PATH - 8 ))
+        {
+            HICON big = NULL;
+
+            lstrcatW( path, L"\\cmd.exe" );
+            win->window_icon_loaded = TRUE;
+            if (ExtractIconExW( path, 0, &big, NULL, 1 ) && big)
+            {
+                if (win->big_icon) DestroyIcon( win->big_icon );
+                win->big_icon = big;
+            }
+        }
+    }
+    if (win->big_icon) return win->big_icon;
+    if (win->icon) return small_icon;
+    /* no icon in the program file (a console window belongs to conhost.exe): the window's own
+     * icon, as Windows shows it, before the generic one */
+    if (!win->window_icon_loaded)
+    {
+        DWORD_PTR icon = 0;
+
+        win->window_icon_loaded = TRUE;
+        if (!SendMessageTimeoutW( win->hwnd, WM_GETICON, ICON_BIG, 0, SMTO_ABORTIFHUNG, 200, &icon ) || !icon)
+            SendMessageTimeoutW( win->hwnd, WM_GETICON, ICON_SMALL2, 0, SMTO_ABORTIFHUNG, 200, &icon );
+        if (!icon) icon = GetClassLongPtrW( win->hwnd, GCLP_HICON );
+        if (!icon) icon = GetClassLongPtrW( win->hwnd, GCLP_HICONSM );
+        win->window_icon = (HICON)icon;
+    }
+    if (win->window_icon) return win->window_icon;
+    /* nothing at all: the Control Panel icon for control.exe, a plain window icon for the rest,
+     * never an empty button */
+    if (!win->fallback_loaded)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD pid = 0, len = ARRAY_SIZE(path);
+        HANDLE process;
+        int id = -3;   /* IDI_SHELL_WINDOW */
+        HICON big = NULL;
+
+        win->fallback_loaded = TRUE;
+        GetWindowThreadProcessId( win->hwnd, &pid );
+        if ((process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+        {
+            if (QueryFullProcessImageNameW( process, 0, path, &len ))
+            {
+                const WCHAR *name = wcsrchr( path, '\\' );
+
+                if (!lstrcmpiW( name ? name + 1 : path, L"control.exe" )) id = -36;  /* IDI_SHELL_CONTROL_PANEL */
+            }
+            CloseHandle( process );
+        }
+        if (ExtractIconExW( L"shell32.dll", id, &big, NULL, 1 ) && big) win->big_icon = big;
+    }
+    return win->big_icon ? win->big_icon : small_icon;
+}
