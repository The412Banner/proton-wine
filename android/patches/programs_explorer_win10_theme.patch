+/* minimize the task windows, or restore the ones minimized by the previous click */
+static void win10_show_desktop(void)
+{
+    struct taskbar_button *win;
+    unsigned int i;
+
+    if (win10_minimized_count)
+    {
+        for (i = 0; i < win10_minimized_count; i++)
+            if (IsWindow( win10_minimized[i] ) && IsIconic( win10_minimized[i] ))
+                PostMessageW( win10_minimized[i], WM_SYSCOMMAND, SC_RESTORE, 0 );
+        win10_minimized_count = 0;
