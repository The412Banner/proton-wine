+/*
+ * Wine Windows 10 desktop background: a deep blue glow with light beams and the Wine glass
+ * in the middle, all drawn here (no picture from Windows). Darker with dark theme colors.
+ */
+static COLORREF win10_wallpaper_base( double d )
+{
+    static const struct { double pos; COLORREF color; } stops[] =
+    {
+        { 0.00, RGB(0x0e,0x55,0xb3) }, { 0.38, RGB(0x08,0x33,0x7a) }, { 0.72, RGB(0x04,0x1b,0x45) },
+        { 1.00, RGB(0x02,0x0c,0x22) },
+    };
+    unsigned int i;
+
+    for (i = 1; i < ARRAY_SIZE(stops); i++)
+        if (d <= stops[i].pos)
+            return blend_color( stops[i - 1].color, stops[i].color, (int)((d - stops[i - 1].pos) * 1000),
+                                (int)((stops[i].pos - stops[i - 1].pos) * 1000) );
+    return stops[ARRAY_SIZE(stops) - 1].color;
+}
+
+static HBITMAP build_win10_wallpaper( HDC ref, int width, int height, BOOL dark )
+{
+    static const struct { double angle, center, half, strength; } beams[] =
+    {
+        { 64.0, 0.66, 0.065, 0.08 }, { 82.0, 0.60, 0.065, 0.11 }, { 101.0, 0.52, 0.055, 0.13 }, { 118.0, 0.41, 0.055, 0.16 },
+    };
+    const COLORREF beam_color = RGB(0x96,0xcd,0xff), glow_color = RGB(0x78,0xc3,0xff), glass_color = RGB(0xd8,0xec,0xff);
+    double sn[ARRAY_SIZE(beams)], cs[ARRAY_SIZE(beams)], len[ARRAY_SIZE(beams)];
+    int x, y, glass, gx, gy;
+    BITMAPINFO info;
+    HBITMAP bitmap;
+    unsigned int i;
+    DWORD *bits;
+    BYTE *alpha;
+
+    if (width <= 0 || height <= 0) return 0;
+    memset( &info, 0, sizeof(info) );
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(bitmap = CreateDIBSection( ref, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 ))) return 0;
+
+    for (i = 0; i < ARRAY_SIZE(beams); i++)
+    {
+        /* like a CSS linear gradient: 0 degrees points up, 90 to the right */
+        sn[i] = sin( beams[i].angle * 3.14159265358979 / 180.0 );
+        cs[i] = cos( beams[i].angle * 3.14159265358979 / 180.0 );
+        len[i] = fabs( width * sn[i] ) + fabs( height * cs[i] );
+    }
+
+    for (y = 0; y < height; y++)
+    {
+        for (x = 0; x < width; x++)
+        {
+            double dx = (x - width * 0.5) / (width * 0.5), dy = (y - height * 0.42) / (height * 0.58);
+            double d = sqrt( dx * dx + dy * dy ) / sqrt( 2.0 ), gdx, gdy, g;
+            COLORREF color = win10_wallpaper_base( min( d, 1.0 ));
+
+            for (i = 0; i < ARRAY_SIZE(beams); i++)
+            {
+                double p = ((x - width * 0.5) * sn[i] - (y - height * 0.5) * cs[i]) / len[i] + 0.5;
+                double v = 1.0 - fabs( p - beams[i].center ) / beams[i].half;
+
+                if (v > 0) color = blend_pixel( color, beam_color, (unsigned int)(v * beams[i].strength * 255) );
+            }
+            gdx = (x - width * 0.5) / (width * 0.55);
+            gdy = (y - height * 0.44) / (height * 0.65);
+            g = 1.0 - sqrt( gdx * gdx + gdy * gdy ) / 0.62;
+            if (g > 0) color = blend_pixel( color, glow_color, (unsigned int)(g * 0.5 * 255) );
+            if (dark) color = blend_color( color, RGB(0,0,0), 3, 10 );
+            bits[y * width + x] = (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+        }
+    }
+
+    glass = height * 24 / 100;
+    gx = (width - glass) / 2;
+    gy = height * 44 / 100 - glass / 2;
+    if (glass > 0 && (alpha = render_wine_glass( glass, FALSE )))
+    {
+        for (y = 0; y < glass; y++)
+        {
+            if (gy + y < 0 || gy + y >= height) continue;
+            for (x = 0; x < glass; x++)
+            {
+                DWORD *pixel;
+                COLORREF color;
+
+                if (gx + x < 0 || gx + x >= width || !alpha[y * glass + x]) continue;
+                pixel = &bits[(gy + y) * width + gx + x];
+                color = RGB( (*pixel >> 16) & 0xff, (*pixel >> 8) & 0xff, *pixel & 0xff );
+                color = blend_pixel( color, glass_color, alpha[y * glass + x] * 92 / 100 );
+                *pixel = (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+            }
+        }
+        free( alpha );
+    }
+    return bitmap;
+}
+
+static HBITMAP build_wallpaper( HDC ref, int width, int height, BOOL dark, BOOL win10 )
+{
+    return win10 ? build_win10_wallpaper( ref, width, height, dark ) : build_xp_wallpaper( ref, width, height, dark );
+}
