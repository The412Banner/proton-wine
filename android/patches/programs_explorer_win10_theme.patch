+/* icon only, with a line in the accent color under it, the active window also lighter */
+static void win10_draw_task_button( HDC hdc, struct taskbar_button *win, int width, int height, BOOL down,
+                                    BOOL hot )
+{
+    COLORREF accent = blend_color( get_accent_color(), RGB(0xff,0xff,0xff), 4, 10 );
+    int size = xp_scale( 24 ), bar = max( 2, xp_scale( 2 )), inset = win->active ? 0 : xp_scale( 8 );
+
+    fill_solid( hdc, 0, 0, width, height, win10_part_color( down, hot ));
+    DrawIconEx( hdc, (width - size) / 2, (height - size) / 2 - xp_scale( 1 ), win10_get_task_icon( win ),
+                size, size, 0, NULL, DI_NORMAL );
+    fill_solid( hdc, inset, height - bar, width - 2 * inset, bar, accent );
+}
