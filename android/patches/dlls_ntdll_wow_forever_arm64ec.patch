          "mov x9, x30\n\t" \
-         "adrp x16, __wine_syscall_dispatcher\n\t" \
+         "ldr x16, [x18, #0x370]\n\t" \
+         "cbz x16, 1f\n\t" \
+         "ldr x16, [x16, #8]\n\t" \
+         "cbnz x16, 2f\n\t" \
+         "1:\tadrp x16, __wine_syscall_dispatcher\n\t" \
          "ldr x16, [x16, :lo12:__wine_syscall_dispatcher]\n\t" \
-         "blr x16\n\t" \
+         "2:\tblr x16\n\t" \
          "ret\n\t" \
          ".seh_endproc" :: "i" (id) )
 #elif defined __arm64ec_x64__
