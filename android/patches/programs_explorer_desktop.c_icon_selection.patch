+/* the selection box, dragged from an empty spot of the desktop */
+static struct
+{
+    BOOL  active;  /* the left button went down on an empty spot */
+    BOOL  shown;   /* the mouse moved far enough to show the box */
+    POINT start;
+    RECT  rect;
+} band;
+
+static int pending_click = -1;  /* a click on one of several selected launchers: it alone is selected at button up */
+
+static void set_launcher_selected( HWND hwnd, unsigned int index, BOOL selected )
+{
+    RECT rect;
+
+    if (launchers[index]->selected == selected) return;
+    launchers[index]->selected = selected;
+    rect = get_launcher_rect( index );
+    InvalidateRect( hwnd, &rect, TRUE );
+}
+
+static void set_focus_launcher( HWND hwnd, int index )
+{
+    struct launcher *launcher = index == -1 ? NULL : launchers[index];
+    unsigned int i;
+    RECT rect;
+
+    if (launcher == focus_launcher) return;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        if (launchers[i] != focus_launcher && launchers[i] != launcher) continue;
+        rect = get_launcher_rect( i );
+        InvalidateRect( hwnd, &rect, TRUE );
+    }
+    focus_launcher = launcher;
+}
+
+/* select the launcher at index alone, or none for -1 */
+static void select_only( HWND hwnd, int index )
+{
+    unsigned int i;
+
+    for (i = 0; i < nb_launchers; i++) set_launcher_selected( hwnd, i, (int)i == index );
+    if (index != -1) set_focus_launcher( hwnd, index );
+}
+
+static unsigned int count_selected(void)
+{
+    unsigned int i, count = 0;
+
+    for (i = 0; i < nb_launchers; i++) if (launchers[i]->selected) count++;
+    return count;
+}
+
+/* a click selects the launcher under the mouse alone and Ctrl+click adds or removes it; a press on an
+ * empty spot clears the selection (not with Ctrl) and starts a selection box; a right click on a
+ * selected launcher, or a click on one of several selected ones, keeps the selection */
+static void end_rename( BOOL commit );
+
+static void mouse_down( HWND hwnd, int x, int y, WPARAM keys, BOOL right_button )
+{
+    int hit = launcher_index_from_point( x, y );
+    unsigned int i;
+
+    end_rename( TRUE );
+    pending_click = -1;
+    if (hit == -1)
+    {
+        if (!(keys & MK_CONTROL)) select_only( hwnd, -1 );
+        if (right_button) return;
+        for (i = 0; i < nb_launchers; i++) launchers[i]->band_base = launchers[i]->selected;
+        band.active = TRUE;
+        band.shown = FALSE;
+        band.start.x = x;
+        band.start.y = y;
+        SetRectEmpty( &band.rect );
+        SetCapture( hwnd );
+        return;
+    }
+    if (right_button)
+    {
+        if (!launchers[hit]->selected) select_only( hwnd, hit );
+        return;
+    }
+    if (keys & MK_CONTROL)
+    {
+        set_launcher_selected( hwnd, hit, !launchers[hit]->selected );
+        set_focus_launcher( hwnd, hit );
+        return;
+    }
+    if (launchers[hit]->selected && count_selected() > 1)
+    {
+        set_focus_launcher( hwnd, hit );
+        pending_click = hit;
+        return;
+    }
+    select_only( hwnd, hit );
+}
+
+/* the box selects every launcher whose icon or title it touches; with Ctrl it inverts them instead */
+static void update_band( HWND hwnd, int x, int y )
+{
+    RECT old = band.rect, dirty;
+    unsigned int i;
+
+    if (!band.shown && abs( x - band.start.x ) < GetSystemMetrics( SM_CXDRAG ) &&
+        abs( y - band.start.y ) < GetSystemMetrics( SM_CYDRAG )) return;
+    band.shown = TRUE;
+    band.rect.left   = min( band.start.x, x );
+    band.rect.top    = min( band.start.y, y );
+    band.rect.right  = max( band.start.x, x ) + 1;
+    band.rect.bottom = max( band.start.y, y ) + 1;
+
+    for (i = 0; i < nb_launchers; i++)
+    {
+        RECT dummy, icon = get_icon_rect( i ), title = get_title_rect( i );
+        BOOL inside = IntersectRect( &dummy, &icon, &band.rect ) || IntersectRect( &dummy, &title, &band.rect );
+
+        set_launcher_selected( hwnd, i, launchers[i]->band_base != inside );
+    }
+    UnionRect( &dirty, &old, &band.rect );
+    InvalidateRect( hwnd, &dirty, FALSE );
+}
+
+static void end_band( HWND hwnd )
+{
+    if (!band.active) return;
+    band.active = FALSE;
+    if (band.shown) InvalidateRect( hwnd, &band.rect, FALSE );
+    band.shown = FALSE;
+    if (GetCapture() == hwnd) ReleaseCapture();
+}
+
+static void mouse_up( HWND hwnd, int x, int y )
+{
+    if (band.active) end_band( hwnd );
+    else if (pending_click != -1)
+    {
+        if (pending_click < (int)nb_launchers && launcher_index_from_point( x, y ) == pending_click)
+            select_only( hwnd, pending_click );
+        pending_click = -1;
+    }
+}
+
+/* the box as Windows XP draws it: the highlight colour, translucent inside, solid border */
+static void draw_band( HDC hdc )
+{
+    static const BLENDFUNCTION blend = { AC_SRC_OVER, 0, 0x50, 0 };
+    HDC mem = CreateCompatibleDC( hdc );
+    HBITMAP bitmap = CreateCompatibleBitmap( hdc, 1, 1 );
+
+    if (mem && bitmap)
+    {
+        HGDIOBJ old = SelectObject( mem, bitmap );
+
+        SetPixel( mem, 0, 0, GetSysColor( COLOR_HIGHLIGHT ) );
+        GdiAlphaBlend( hdc, band.rect.left, band.rect.top, band.rect.right - band.rect.left,
+                       band.rect.bottom - band.rect.top, mem, 0, 0, 1, 1, blend );
+        SelectObject( mem, old );
+    }
+    if (bitmap) DeleteObject( bitmap );
+    if (mem) DeleteDC( mem );
+    FrameRect( hdc, &band.rect, GetSysColorBrush( COLOR_HIGHLIGHT ) );
+}
+
+/* in-place rename of a launcher title, as on Windows */
+#define WM_RENAME_END (WM_APP + 1)
+static HWND rename_edit;
+static HFONT rename_font;
+static struct launcher *rename_launcher;
+static WNDPROC rename_orig_proc;
+
+static BOOL launcher_exists( const struct launcher *launcher )
+{
+    unsigned int i;
+
+    for (i = 0; i < nb_launchers; i++) if (launchers[i] == launcher) return TRUE;
+    return FALSE;
+}
+
+/* the new name goes to the .lnk file; the folder watcher then shows the launcher under it */
+static void end_rename( BOOL commit )
+{
+    WCHAR name[MAX_PATH], *path, *slash;
+    HWND edit = rename_edit;
+    int len = 0, dir_len;
+
+    if (!edit) return;
+    rename_edit = NULL;
+    if (commit) len = GetWindowTextW( edit, name, ARRAY_SIZE(name) - 5 );
+    DestroyWindow( edit );
+    if (rename_font) DeleteObject( rename_font );
+    rename_font = 0;
+
+    while (len && name[len - 1] == ' ') name[--len] = 0;
+    if (!len || !launcher_exists( rename_launcher ) || !wcscmp( name, rename_launcher->title )) return;
+    if (wcspbrk( name, L"\\/:*?\"<>|" ) || !(slash = wcsrchr( rename_launcher->path, '\\' )))
+    {
+        MessageBeep( MB_ICONWARNING );
+        return;
+    }
+    dir_len = slash - rename_launcher->path + 1;
+    if (!(path = malloc( (dir_len + len + 5) * sizeof(WCHAR) ))) return;
+    memcpy( path, rename_launcher->path, dir_len * sizeof(WCHAR) );
+    memcpy( path + dir_len, name, len * sizeof(WCHAR) );
+    lstrcpyW( path + dir_len + len, L".lnk" );
+    if (!MoveFileW( rename_launcher->path, path )) MessageBeep( MB_ICONWARNING );
+    free( path );
+}
+
+static LRESULT CALLBACK rename_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_GETDLGCODE:
+        return DLGC_WANTALLKEYS;
+    case WM_KEYDOWN:
+        if (wp == VK_RETURN || wp == VK_ESCAPE)
+        {
+            end_rename( wp == VK_RETURN );
+            return 0;
+        }
+        break;
+    case WM_CHAR:
+        if (wp == '\r' || wp == 0x1b) return 0;
+        break;
+    case WM_KILLFOCUS:
+        PostMessageW( hwnd, WM_RENAME_END, 0, 0 );
+        break;
+    case WM_RENAME_END:
+        if (hwnd == rename_edit) end_rename( TRUE );
+        return 0;
+    }
+    return CallWindowProcW( rename_orig_proc, hwnd, msg, wp, lp );
+}
+
+static void start_rename( HWND hwnd, unsigned int index )
+{
+    RECT rect = get_title_rect( index );
+    LOGFONTW lf;
+
+    end_rename( TRUE );
+    MapWindowPoints( hwnd, 0, (POINT *)&rect, 2 );
+    rename_edit = CreateWindowExW( WS_EX_TOPMOST, L"Edit", launchers[index]->title,
+                                   WS_POPUP | WS_BORDER | ES_AUTOHSCROLL | ES_CENTER,
+                                   rect.left - 2, rect.top - 1, rect.right - rect.left + 4, title_cy / 2 + 6,
+                                   hwnd, 0, 0, NULL );
+    if (!rename_edit) return;
+    rename_launcher = launchers[index];
+    SystemParametersInfoW( SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0 );
+    if ((rename_font = CreateFontIndirectW( &lf ))) SendMessageW( rename_edit, WM_SETFONT, (WPARAM)rename_font, FALSE );
+    rename_orig_proc = (WNDPROC)SetWindowLongPtrW( rename_edit, GWLP_WNDPROC, (LONG_PTR)rename_proc );
+    SendMessageW( rename_edit, EM_SETSEL, 0, -1 );
+    ShowWindow( rename_edit, SW_SHOW );
+    SetForegroundWindow( rename_edit );
+    SetFocus( rename_edit );
+}
+
+/* the selected launchers go to the Trash together, with one confirmation */
+static void delete_selected(void)
+{
+    SHFILEOPSTRUCTW op = { 0 };
+    unsigned int i, size = 1;
+    WCHAR *list, *p;
+
+    for (i = 0; i < nb_launchers; i++) if (launchers[i]->selected) size += lstrlenW( launchers[i]->path ) + 1;
+    if (size == 1 || !(list = p = malloc( size * sizeof(WCHAR) ))) return;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        if (!launchers[i]->selected) continue;
+        lstrcpyW( p, launchers[i]->path );
+        p += lstrlenW( p ) + 1;
+    }
+    *p = 0;
+    op.wFunc = FO_DELETE;
+    op.pFrom = list;
+    op.fFlags = FOF_ALLOWUNDO;
+    SHFileOperationW( &op );
+    free( list );
+}
+
+/* Properties of several selected launchers: one sheet for all of them, as Windows shows it */
+struct multi_properties
+{
+    WCHAR      **paths;
+    unsigned int count;
+};
+
+static const struct { UINT id; DWORD attr; } multi_attribs[] =
+{
+    { IDC_MP_READONLY, FILE_ATTRIBUTE_READONLY },
+    { IDC_MP_HIDDEN,   FILE_ATTRIBUTE_HIDDEN },
+    { IDC_MP_ARCHIVE,  FILE_ATTRIBUTE_ARCHIVE },
+};
+
+static void init_multi_properties( HWND dlg, const struct multi_properties *props )
+{
+    WCHAR format[64], text[MAX_PATH + 64], type[80], first_type[80] = { 0 }, folder[MAX_PATH] = { 0 };
+    WCHAR size[32], bytes[32];
+    unsigned int i, j, set[ARRAY_SIZE(multi_attribs)] = { 0 };
+    BOOL same_type = TRUE, same_folder = TRUE;
+    HMODULE shell32 = GetModuleHandleW( L"shell32.dll" );
+    ULONGLONG total = 0;
+
+    if (shell32)  /* IDI_SHELL_FILES */
+        SendDlgItemMessageW( dlg, IDC_MP_ICON, STM_SETICON,
+                             (WPARAM)LoadImageW( shell32, MAKEINTRESOURCEW( 133 ), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE ), 0 );
+
+    for (i = 0; i < props->count; i++)
+    {
+        const WCHAR *slash = wcsrchr( props->paths[i], '\\' );
+        size_t dir_len = slash ? slash - props->paths[i] : 0;
+        WIN32_FILE_ATTRIBUTE_DATA data;
+        SHFILEINFOW info;
+
+        if (GetFileAttributesExW( props->paths[i], GetFileExInfoStandard, &data ))
+        {
+            total += ((ULONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+            for (j = 0; j < ARRAY_SIZE(multi_attribs); j++)
+                if (data.dwFileAttributes & multi_attribs[j].attr) set[j]++;
+        }
+        type[0] = 0;
+        if (SHGetFileInfoW( props->paths[i], 0, &info, sizeof(info), SHGFI_TYPENAME ))
+            lstrcpynW( type, info.szTypeName, ARRAY_SIZE(type) );
+        if (!i)
+        {
+            lstrcpyW( first_type, type );
+            lstrcpynW( folder, props->paths[i], min( dir_len + 1, ARRAY_SIZE(folder) ) );
+        }
+        else
+        {
+            if (wcscmp( type, first_type )) same_type = FALSE;
+            if (dir_len != wcslen( folder ) || wcsnicmp( props->paths[i], folder, dir_len )) same_folder = FALSE;
+        }
+    }
+
+    LoadStringW( NULL, IDS_MP_FILES, format, ARRAY_SIZE(format) );
+    swprintf( text, ARRAY_SIZE(text), format, props->count );
+    SetDlgItemTextW( dlg, IDC_MP_COUNT, text );
+
+    if (same_type)
+    {
+        LoadStringW( NULL, IDS_MP_ALL_TYPE, format, ARRAY_SIZE(format) );
+        swprintf( text, ARRAY_SIZE(text), format, first_type );
+    }
+    else LoadStringW( NULL, IDS_MP_MULTIPLE_TYPES, text, ARRAY_SIZE(text) );
+    SetDlgItemTextW( dlg, IDC_MP_TYPE, text );
+
+    if (same_folder)
+    {
+        LoadStringW( NULL, IDS_MP_ALL_IN, format, ARRAY_SIZE(format) );
+        swprintf( text, ARRAY_SIZE(text), format, folder );
+    }
+    else LoadStringW( NULL, IDS_MP_VARIOUS_FOLDERS, text, ARRAY_SIZE(text) );
+    SetDlgItemTextW( dlg, IDC_MP_LOCATION, text );
+
+    StrFormatByteSizeW( total, size, ARRAY_SIZE(size) );
+    swprintf( bytes, ARRAY_SIZE(bytes), L"%I64u", total );
+    LoadStringW( NULL, IDS_MP_SIZE, format, ARRAY_SIZE(format) );
+    swprintf( text, ARRAY_SIZE(text), format, size, bytes );
+    SetDlgItemTextW( dlg, IDC_MP_SIZE, text );
+
+    /* an attribute that only some of them have shows the third (mixed) state */
+    for (j = 0; j < ARRAY_SIZE(multi_attribs); j++)
+    {
+        HWND button = GetDlgItem( dlg, multi_attribs[j].id );
+
+        if (!set[j] || set[j] == props->count)
+        {
+            SendMessageW( button, BM_SETSTYLE, BS_AUTOCHECKBOX, FALSE );
+            SendMessageW( button, BM_SETCHECK, set[j] ? BST_CHECKED : BST_UNCHECKED, 0 );
+        }
+        else SendMessageW( button, BM_SETCHECK, BST_INDETERMINATE, 0 );
+    }
+}
+
+static INT_PTR CALLBACK multi_properties_proc( HWND dlg, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct multi_properties *props = (struct multi_properties *)GetWindowLongPtrW( dlg, DWLP_USER );
+    unsigned int i, j;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        props = (struct multi_properties *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW( dlg, DWLP_USER, (LONG_PTR)props );
+        init_multi_properties( dlg, props );
+        return TRUE;
+
+    case WM_COMMAND:
+        for (j = 0; j < ARRAY_SIZE(multi_attribs); j++)
+            if (LOWORD(wp) == multi_attribs[j].id && HIWORD(wp) == BN_CLICKED)
+                SendMessageW( GetParent( dlg ), PSM_CHANGED, (WPARAM)dlg, 0 );
+        break;
+
+    case WM_NOTIFY:
+        if (((NMHDR *)lp)->code != PSN_APPLY || !props) break;
+        for (i = 0; i < props->count; i++)
+        {
+            DWORD attr = GetFileAttributesW( props->paths[i] ), new_attr;
+
+            if (attr == INVALID_FILE_ATTRIBUTES) continue;
+            new_attr = attr;
+            for (j = 0; j < ARRAY_SIZE(multi_attribs); j++)
+            {
+                UINT state = IsDlgButtonChecked( dlg, multi_attribs[j].id );
+
+                if (state == BST_CHECKED) new_attr |= multi_attribs[j].attr;
+                else if (state == BST_UNCHECKED) new_attr &= ~multi_attribs[j].attr;
+            }
+            if (new_attr != attr) SetFileAttributesW( props->paths[i], new_attr ? new_attr : FILE_ATTRIBUTE_NORMAL );
+        }
+        SetWindowLongPtrW( dlg, DWLP_MSGRESULT, PSNRET_NOERROR );
+        return TRUE;
+
+    case WM_DESTROY:
+    {
+        HICON icon = (HICON)SendDlgItemMessageW( dlg, IDC_MP_ICON, STM_GETICON, 0, 0 );
+
+        if (icon) DestroyIcon( icon );
+        break;
+    }
+    }
+    return FALSE;
+}
+
+static void show_multi_properties(void)
+{
+    struct multi_properties props = { 0 };
+    PROPSHEETPAGEW page = { sizeof(page) };
+    PROPSHEETHEADERW header = { sizeof(header) };
+    WCHAR caption[MAX_PATH] = { 0 };
+    unsigned int i;
+
+    if (!nb_launchers || !(props.paths = calloc( nb_launchers, sizeof(*props.paths) ))) return;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        if (!launchers[i]->selected || !(props.paths[props.count] = wcsdup( launchers[i]->path ))) continue;
+        if (props.count < 2)
+        {
+            if (props.count) wcsncat( caption, L", ", ARRAY_SIZE(caption) - wcslen( caption ) - 1 );
+            wcsncat( caption, launchers[i]->title, ARRAY_SIZE(caption) - wcslen( caption ) - 1 );
+        }
+        else if (props.count == 2) wcsncat( caption, L", ...", ARRAY_SIZE(caption) - wcslen( caption ) - 1 );
+        props.count++;
+    }
+
+    if (props.count)
+    {
+        page.hInstance = GetModuleHandleW( NULL );
+        page.pszTemplate = MAKEINTRESOURCEW( IDD_MULTI_PROPERTIES );
+        page.pfnDlgProc = multi_properties_proc;
+        page.lParam = (LPARAM)&props;
+        /* no owner: a dialog owned by the desktop window would leave it disabled */
+        header.dwFlags = PSH_PROPSHEETPAGE | PSH_PROPTITLE;
+        header.hInstance = page.hInstance;
+        header.pszCaption = caption;
+        header.nPages = 1;
+        header.ppsp = &page;
+        PropertySheetW( &header );
+    }
+    for (i = 0; i < props.count; i++) free( props.paths[i] );
+    free( props.paths );
+}
+
+static BOOL launcher_in_folder( const struct launcher *launcher, const WCHAR *folder )
+{
+    int len = lstrlenW( folder );
+
+    return !wcsnicmp( launcher->path, folder, len ) && launcher->path[len] == '\\' &&
+           !wcschr( launcher->path + len + 1, '\\' );
+}
+
+/* the shell's context menu of the selected launchers of one desktop folder, or NULL */
+static IContextMenu *get_folder_menu( HWND hwnd, const WCHAR *folder )
+{
+    IShellFolder *desktop, *shell_folder = NULL;
+    IContextMenu *menu = NULL;
+    LPITEMIDLIST pidl, *children;
+    unsigned int i, count = 0;
+
+    if (!folder || !nb_launchers || !(children = calloc( nb_launchers, sizeof(*children) ))) return NULL;
+    if (SUCCEEDED( SHGetDesktopFolder( &desktop ) ))
+    {
+        if (SUCCEEDED( SHParseDisplayName( folder, NULL, &pidl, 0, NULL ) ))
+        {
+            IShellFolder_BindToObject( desktop, pidl, NULL, &IID_IShellFolder, (void **)&shell_folder );
+            ILFree( pidl );
+        }
+        IShellFolder_Release( desktop );
+    }
+    if (shell_folder)
+    {
+        for (i = 0; i < nb_launchers; i++)
+        {
+            if (!launchers[i]->selected || !launcher_in_folder( launchers[i], folder )) continue;
+            if (SUCCEEDED( IShellFolder_ParseDisplayName( shell_folder, hwnd, NULL,
+                                                          launchers[i]->path + lstrlenW( folder ) + 1,
+                                                          NULL, &children[count], NULL ) ))
+                count++;
+        }
+        if (count)
+            IShellFolder_GetUIObjectOf( shell_folder, hwnd, count, (LPCITEMIDLIST *)children,
+                                        &IID_IContextMenu, NULL, (void **)&menu );
+        IShellFolder_Release( shell_folder );
+    }
+    for (i = 0; i < count; i++) ILFree( children[i] );
+    free( children );
+    return menu;
+}
