     icon = get_icon_rect( index );
     title = get_title_rect( index );
     if ((x < icon.left || x > icon.right || y < icon.top || y > icon.bottom) &&
-        (x < title.left || x > title.right || y < title.top || y > title.bottom)) return NULL;
-    return launchers[index];
+        (x < title.left || x > title.right || y < title.top || y > title.bottom)) return -1;
+    return index;
+}
+
+static const struct launcher *launcher_from_point( int x, int y )
+{
+    int index = launcher_index_from_point( x, y );
+
+    return index == -1 ? NULL : launchers[index];
+}
+
+/* a click selects the launcher under the mouse alone, or clears the selection on an empty spot;
+ * a right click on a launcher that is already selected keeps the selection */
+static void select_launcher_at( HWND hwnd, int x, int y, BOOL right_button )
+{
+    int hit = launcher_index_from_point( x, y );
+    unsigned int i;
+
+    if (hit != -1 && right_button && launchers[hit]->selected) return;
+    if (hit != -1) focus_launcher = launchers[hit];
+
+    for (i = 0; i < nb_launchers; i++)
+    {
+        BOOL selected = ((int)i == hit);
+        RECT rect;
+
+        if (launchers[i]->selected == selected) continue;
+        launchers[i]->selected = selected;
+        rect = get_launcher_rect( i );
+        InvalidateRect( hwnd, &rect, TRUE );
+    }
+}
+
+/* the highlight box behind the title of a selected launcher: the drawn lines, centred, with a margin */
+static RECT get_title_box( HDC hdc, unsigned int index, const WCHAR *text )
+{
+    RECT title = get_title_rect( index ), box = title;
+    int width;
+
+    DrawTextW( hdc, text, -1, &box, DT_CALCRECT|DT_CENTER|DT_WORDBREAK|DT_EDITCONTROL|DT_END_ELLIPSIS );
+    width = min( box.right - box.left, title.right - title.left );
+    box.left = title.left + (title.right - title.left - width) / 2;
+    box.right = box.left + width;
+    box.top = title.top;
+    box.bottom = min( box.bottom, title.bottom );
+    InflateRect( &box, 2, 1 );
+    return box;
+}
+
+/* a selected launcher has its icon tinted with the highlight colour, as Windows draws it */
+static void draw_launcher_icon( HDC hdc, const struct launcher *launcher, RECT rect )
+{
+    if (launcher->selected)
+    {
+        HIMAGELIST list = ImageList_Create( icon_cx, icon_cy, ILC_COLOR32 | ILC_MASK, 1, 0 );
+        BOOL drawn = FALSE;
