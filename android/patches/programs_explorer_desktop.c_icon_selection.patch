+/* a selected launcher has its icon tinted with the highlight colour, as Windows draws it */
+static void draw_launcher_icon( HDC hdc, const struct launcher *launcher, RECT rect )
+{
+    if (launcher->selected)
+    {
+        HIMAGELIST list = ImageList_Create( icon_cx, icon_cy, ILC_COLOR32 | ILC_MASK, 1, 0 );
+        BOOL drawn = FALSE;
+
+        if (list)
+        {
+            if (ImageList_AddIcon( list, launcher->icon ) != -1)
+                drawn = ImageList_DrawEx( list, 0, hdc, rect.left, rect.top, icon_cx, icon_cy, CLR_NONE,
+                                          GetSysColor( COLOR_HIGHLIGHT ), ILD_TRANSPARENT | ILD_BLEND50 );
+            ImageList_Destroy( list );
+        }
+        if (drawn) return;
+    }
+    DrawIconEx( hdc, rect.left, rect.top, launcher->icon, icon_cx, icon_cy, 0, 0, DI_DEFAULTSIZE|DI_NORMAL );
 }
 
