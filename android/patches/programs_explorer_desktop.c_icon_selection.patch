+#define IDM_LAUNCHER_FIRST 1       /* the shell menu commands */
+#define IDM_LAUNCHER_LAST  0x6fff
+#define IDM_LAUNCHER_OPEN  0x7000
+
+/* one name at a time: the shell only knows about the selected launchers of one folder */
+static void disable_rename( HMENU menu, IContextMenu *context )
+{
+    int i, count = GetMenuItemCount( menu );
+
+    for (i = 0; i < count; i++)
+    {
+        UINT id = GetMenuItemID( menu, i );
+        WCHAR verb[32] = { 0 };
+
+        if (id < IDM_LAUNCHER_FIRST || id > IDM_LAUNCHER_LAST) continue;
+        if (SUCCEEDED( IContextMenu_GetCommandString( context, id - IDM_LAUNCHER_FIRST, GCS_VERBW, NULL,
+                                                      (char *)verb, ARRAY_SIZE(verb) ) ) &&
+            !wcscmp( verb, L"rename" ))
+            EnableMenuItem( menu, id, MF_BYCOMMAND | MF_GRAYED );
+    }
+}
