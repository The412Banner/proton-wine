+
+/* the selection box, dragged from an empty spot of the desktop */
+static struct
+{
+    BOOL  active;  /* the left button went down on an empty spot */
+    BOOL  shown;   /* the mouse moved far enough to show the box */
+    POINT start;
+    RECT  rect;
+} band;
+
+static int pending_click = -1;  /* a click on one of several selected launchers: it alone is selected at button up */
+
+static void set_launcher_selected( HWND hwnd, unsigned int index, BOOL selected )
+{
+    RECT rect;
+
+    if (launchers[index]->selected == selected) return;
+    launchers[index]->selected = selected;
+    rect = get_launcher_rect( index );
+    InvalidateRect( hwnd, &rect, TRUE );
+}
+
+static void set_focus_launcher( HWND hwnd, int index )
+{
+    struct launcher *launcher = index == -1 ? NULL : launchers[index];
+    unsigned int i;
+    RECT rect;
+
+    if (launcher == focus_launcher) return;
+    for (i = 0; i < nb_launchers; i++)
+    {
+        if (launchers[i] != focus_launcher && launchers[i] != launcher) continue;
+        rect = get_launcher_rect( i );
+        InvalidateRect( hwnd, &rect, TRUE );
+    }
+    focus_launcher = launcher;
+}
+
+/* select the launcher at index alone, or none for -1 */
+static void select_only( HWND hwnd, int index )
+{
+    unsigned int i;
+
+    for (i = 0; i < nb_launchers; i++) set_launcher_selected( hwnd, i, (int)i == index );
+    if (index != -1) set_focus_launcher( hwnd, index );
+}
+
+static unsigned int count_selected(void)
+{
+    unsigned int i, count = 0;
+
+    for (i = 0; i < nb_launchers; i++) if (launchers[i]->selected) count++;
+    return count;
+}
+
+/* a click selects the launcher under the mouse alone and Ctrl+click adds or removes it; a press on an
+ * empty spot clears the selection (not with Ctrl) and starts a selection box; a right click on a
+ * selected launcher, or a click on one of several selected ones, keeps the selection */
+static void mouse_down( HWND hwnd, int x, int y, WPARAM keys, BOOL right_button )
+{
+    int hit = launcher_index_from_point( x, y );
+    unsigned int i;
+
+    pending_click = -1;
+    if (hit == -1)
+    {
+        if (!(keys & MK_CONTROL)) select_only( hwnd, -1 );
+        if (right_button) return;
+        for (i = 0; i < nb_launchers; i++) launchers[i]->band_base = launchers[i]->selected;
+        band.active = TRUE;
+        band.shown = FALSE;
+        band.start.x = x;
+        band.start.y = y;
+        SetRectEmpty( &band.rect );
+        SetCapture( hwnd );
+        return;
+    }
+    if (right_button)
+    {
+        if (!launchers[hit]->selected) select_only( hwnd, hit );
+        return;
+    }
+    if (keys & MK_CONTROL)
+    {
+        set_launcher_selected( hwnd, hit, !launchers[hit]->selected );
+        set_focus_launcher( hwnd, hit );
+        return;
+    }
+    if (launchers[hit]->selected && count_selected() > 1)
+    {
+        set_focus_launcher( hwnd, hit );
+        pending_click = hit;
+        return;
+    }
+    select_only( hwnd, hit );
+}
+
+/* the box selects every launcher whose icon or title it touches; with Ctrl it inverts them instead */
+static void update_band( HWND hwnd, int x, int y )
+{
+    RECT old = band.rect, dirty;
+    unsigned int i;
+
+    if (!band.shown && abs( x - band.start.x ) < GetSystemMetrics( SM_CXDRAG ) &&
+        abs( y - band.start.y ) < GetSystemMetrics( SM_CYDRAG )) return;
+    band.shown = TRUE;
+    band.rect.left   = min( band.start.x, x );
+    band.rect.top    = min( band.start.y, y );
+    band.rect.right  = max( band.start.x, x ) + 1;
+    band.rect.bottom = max( band.start.y, y ) + 1;
+
+    for (i = 0; i < nb_launchers; i++)
+    {
+        RECT dummy, icon = get_icon_rect( i ), title = get_title_rect( i );
+        BOOL inside = IntersectRect( &dummy, &icon, &band.rect ) || IntersectRect( &dummy, &title, &band.rect );
+
+        set_launcher_selected( hwnd, i, launchers[i]->band_base != inside );
+    }
+    UnionRect( &dirty, &old, &band.rect );
+    InvalidateRect( hwnd, &dirty, FALSE );
+}
+
+static void end_band( HWND hwnd )
+{
+    if (!band.active) return;
+    band.active = FALSE;
+    if (band.shown) InvalidateRect( hwnd, &band.rect, FALSE );
+    band.shown = FALSE;
+    if (GetCapture() == hwnd) ReleaseCapture();
+}
+
+static void mouse_up( HWND hwnd, int x, int y )
+{
+    if (band.active) end_band( hwnd );
+    else if (pending_click != -1)
+    {
+        if (pending_click < (int)nb_launchers && launcher_index_from_point( x, y ) == pending_click)
+            select_only( hwnd, pending_click );
+        pending_click = -1;
+    }
+}
+
+/* the box as Windows XP draws it: the highlight colour, translucent inside, solid border */
+static void draw_band( HDC hdc )
+{
+    static const BLENDFUNCTION blend = { AC_SRC_OVER, 0, 0x50, 0 };
+    HDC mem = CreateCompatibleDC( hdc );
+    HBITMAP bitmap = CreateCompatibleBitmap( hdc, 1, 1 );
+
+    if (mem && bitmap)
+    {
+        HGDIOBJ old = SelectObject( mem, bitmap );
+
+        SetPixel( mem, 0, 0, GetSysColor( COLOR_HIGHLIGHT ) );
+        GdiAlphaBlend( hdc, band.rect.left, band.rect.top, band.rect.right - band.rect.left,
+                       band.rect.bottom - band.rect.top, mem, 0, 0, 1, 1, blend );
+        SelectObject( mem, old );
+    }
+    if (bitmap) DeleteObject( bitmap );
+    if (mem) DeleteDC( mem );
+    FrameRect( hdc, &band.rect, GetSysColorBrush( COLOR_HIGHLIGHT ) );
+}
+
+/* the highlight box behind the title of a selected launcher: the drawn lines, centred, with a margin */
+static RECT get_title_box( HDC hdc, unsigned int index, const WCHAR *text )
+{
+    RECT title = get_title_rect( index ), box = title;
+    int width;
+
+    DrawTextW( hdc, text, -1, &box, DT_CALCRECT|DT_CENTER|DT_WORDBREAK|DT_EDITCONTROL|DT_END_ELLIPSIS );
+    width = min( box.right - box.left, title.right - title.left );
+    box.left = title.left + (title.right - title.left - width) / 2;
+    box.right = box.left + width;
+    box.top = title.top;
+    box.bottom = min( box.bottom, title.bottom );
+    InflateRect( &box, 2, 1 );
+    return box;
+}
+
+/* a selected launcher has its icon tinted with the highlight colour, as Windows draws it */
+static void draw_launcher_icon( HDC hdc, const struct launcher *launcher, RECT rect )
+{
+    if (launcher->selected)
