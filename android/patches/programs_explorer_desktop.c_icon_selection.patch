+/* right click on a selected launcher: Open, then the shell's file menu (Cut, Copy, Create Link, Delete,
+ * Rename, Properties); a command runs on the selected launchers of both desktop folders */
+static void show_launcher_menu( HWND hwnd, unsigned int index, LPARAM lparam )
+{
+    const WCHAR *folders[2] = { desktop_folder, desktop_folder_public };
+    IContextMenu *menus[2], *main_menu;
+    WCHAR str[64], verb[32] = { 0 };
+    unsigned int i, g;
+    HMENU menu;
+    POINT pt;
+    int cmd;
+
+    for (g = 0; g < 2; g++) menus[g] = get_folder_menu( hwnd, folders[g] );
+    main_menu = menus[folders[1] && launcher_in_folder( launchers[index], folders[1] ) ? 1 : 0];
+    if (!main_menu) main_menu = menus[0] ? menus[0] : menus[1];
+    if (!(menu = CreatePopupMenu())) goto done;
+
+    LoadStringW( NULL, IDS_DESKTOP_OPEN, str, ARRAY_SIZE(str) );
+    AppendMenuW( menu, MF_STRING, IDM_LAUNCHER_OPEN, str );
+    if (main_menu)
+    {
+        AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+        IContextMenu_QueryContextMenu( main_menu, menu, 2, IDM_LAUNCHER_FIRST, IDM_LAUNCHER_LAST, CMF_CANRENAME );
+        if (count_selected() > 1) disable_rename( menu, main_menu );
+    }
+    SetMenuDefaultItem( menu, IDM_LAUNCHER_OPEN, FALSE );
+
+    pt.x = (short)LOWORD( lparam );
+    pt.y = (short)HIWORD( lparam );
+    ClientToScreen( hwnd, &pt );
+    cmd = TrackPopupMenuEx( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_LEFTALIGN, pt.x, pt.y, hwnd, NULL );
+    DestroyMenu( menu );
+
+    if (cmd == IDM_LAUNCHER_OPEN)
+    {
+        for (i = 0; i < nb_launchers; i++)
+            if (launchers[i]->selected) ShellExecuteW( NULL, L"open", launchers[i]->path, NULL, NULL, SW_SHOWNORMAL );
+    }
+    else if (cmd >= IDM_LAUNCHER_FIRST && cmd <= IDM_LAUNCHER_LAST && main_menu)
+    {
+        IContextMenu_GetCommandString( main_menu, cmd - IDM_LAUNCHER_FIRST, GCS_VERBW, NULL, (char *)verb,
+                                       ARRAY_SIZE(verb) );
+        if (!wcscmp( verb, L"rename" )) start_rename( hwnd, index );
+        else if (!wcscmp( verb, L"delete" )) delete_selected();
+        else if (!wcscmp( verb, L"properties" ) && count_selected() > 1) show_multi_properties();
+        else
+        {
+            static BOOL ole_ready;  /* Cut and Copy use the OLE clipboard */
+
+            if (!ole_ready) ole_ready = SUCCEEDED( OleInitialize( NULL ) );
+            for (g = 0; g < 2; g++)
+            {
+                /* no owner: a dialog owned by the desktop window would leave it disabled */
+                CMINVOKECOMMANDINFO info = { sizeof(info) };
+                HMENU dummy;
+
+                if (!menus[g]) continue;
+                if (menus[g] != main_menu && (dummy = CreatePopupMenu()))
+                {
+                    IContextMenu_QueryContextMenu( menus[g], dummy, 0, IDM_LAUNCHER_FIRST, IDM_LAUNCHER_LAST,
+                                                   CMF_CANRENAME );
+                    DestroyMenu( dummy );
+                }
+                info.lpVerb = MAKEINTRESOURCEA( cmd - IDM_LAUNCHER_FIRST );
+                info.nShow = SW_SHOWNORMAL;
+                IContextMenu_InvokeCommand( menus[g], &info );
+            }
+        }
+    }
+
+done:
+    for (g = 0; g < 2; g++) if (menus[g]) IContextMenu_Release( menus[g] );
+}
