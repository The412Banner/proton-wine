+/* the whole cell of a launcher: its icon, its title and the highlight box around the title */
+static RECT get_launcher_rect( unsigned int index )
+{
+    RECT rect;
+
+    rect.left   = (index % launchers_per_row) * launcher_size;
+    rect.right  = rect.left + launcher_size;
+    rect.top    = (index / launchers_per_row) * launcher_size;
+    rect.bottom = rect.top + launcher_size;
+    return rect;
+}
+
