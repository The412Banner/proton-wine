@@ -4948,6 +4986,7 @@ void loader_init( CONTEXT *context, void **entry )
             InitializeListHead( &hash_table[i] );
 
         init_user_process_params();
+        apply_app_environment_hacks();
         load_global_options();
         version_init();
         open_known_dll_ntdir();
