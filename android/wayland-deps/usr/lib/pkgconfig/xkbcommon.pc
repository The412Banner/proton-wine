prefix=/data/data/com.termux/files/usr
includedir=${prefix}/include
libdir=${prefix}/lib

xkb_root=/data/data/com.termux/files/usr/share/xkeyboard-config-2
xkb_extra_path=/data/data/com.termux/files/usr/etc/xkb
xkb_unversioned_extensions_path=/data/data/com.termux/files/usr/share/xkeyboard-config.d
xkb_versioned_extensions_path=/data/data/com.termux/files/usr/share/xkeyboard-config-2.d

Name: xkbcommon
Description: XKB API common to servers and clients
Version: 1.13.1
Libs: -L${libdir} -lxkbcommon
Cflags: -I${includedir}
