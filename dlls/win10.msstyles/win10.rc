"\r\n"
"[Status.Gripper]\r\n"
"BgType = ImageFile\r\n"
"ImageFile = dark_status_gripper.bmp\r\n"
"SizingType = TrueSize\r\n"
"Transparent = True\r\n"
"\r\n"
"[Rebar]\r\n"
"BgType = None\r\n"
"\r\n"
"[Rebar.Gripper]\r\n"
"BgType = ImageFile\r\n"
"ImageFile = rebar_gripper.bmp\r\n"
"SizingType = Tile\r\n"
"Transparent = True\r\n"
"\r\n"
"[Rebar.GripperVert]\r\n"
"BgType = ImageFile\r\n"
"ImageFile = rebar_gripper.bmp\r\n"
"SizingType = Tile\r\n"
"Transparent = True\r\n"
"\r\n"
"[Rebar.Chevron]\r\n"
"BgType = ImageFile\r\n"
"ImageFile = dark_rebar_chevron.bmp\r\n"
"ImageCount = 3\r\n"
"ImageLayout = Vertical\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 4, 4, 4, 4\r\n"
"Transparent = True\r\n"
"GlyphType = ImageGlyph\r\n"
"GlyphImageFile = rebar_chevron_glyph.bmp\r\n"
"GlyphTransparent = True\r\n"
"\r\n"
"[Rebar.ChevronVert]\r\n"
"BgType = ImageFile\r\n"
"ImageFile = dark_rebar_chevron.bmp\r\n"
"ImageCount = 3\r\n"
"ImageLayout = Vertical\r\n"
"SizingType = Stretch\r\n"
"SizingMargins = 4, 4, 4, 4\r\n"
"Transparent = True\r\n"
"GlyphType = ImageGlyph\r\n"
"GlyphImageFile = rebar_chevron_vert_glyph.bmp\r\n"
"GlyphTransparent = True\r\n"
"\r\n"
}

